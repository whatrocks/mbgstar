---
/*
 * Build-a-Bandmate: clay versions of the band. Hand each one an instrument,
 * hit Play, and they jam through Wake Up Call on a little Web Audio band
 * that only plays the parts somebody is holding. Mics sing the tune, and
 * more mics sing harmonies.
 */

type Head = 'round' | 'tipLeft' | 'tipRight' | 'square';

interface Member {
  name: string;
  /** One color of plasticine, head to toe. */
  clay: string;
  head: Head;
  /** Crown and brim colors, if they wear a cap. */
  cap?: [string, string];
}

const members: Member[] = [
  { name: 'Andy', clay: '#d9440d', head: 'tipLeft' },
  { name: 'Ben', clay: '#ffd23f', head: 'round', cap: ['#f2e4cc', '#0b7a72'] },
  { name: 'Charlie', clay: '#0b9a8f', head: 'round' },
  { name: 'John', clay: '#e8202a', head: 'square' },
  { name: 'Zach', clay: '#3b4cca', head: 'tipRight' },
];

const instruments = [
  { id: 'piano', label: 'Piano', icon: '-84 -16 168 112' },
  { id: 'bass', label: 'Bass', icon: '-40 -34 172 68' },
  { id: 'electric', label: 'Electric guitar', icon: '-40 -34 154 68' },
  { id: 'acoustic', label: 'Acoustic guitar', icon: '-40 -30 152 60' },
  { id: 'banjo', label: 'Banjo', icon: '-30 -30 152 60' },
  { id: 'drums', label: 'Drums', icon: '-98 -92 196 140' },
  { id: 'mic', label: 'Mic', icon: '104 116 46 50' },
  { id: 'harmonica', label: 'Harmonica', icon: '78 98 44 28' },
];

/** A pear of a body on short, stubby legs with rounded feet. */
const bodyPath =
  'M100 122 C126 122 146 132 148 156 L150 238 C151 258 152 274 152 288 C152 302 142 306 128 305 ' +
  'L114 304 C108 303 106 296 106 288 C106 274 104 264 100 262 C96 264 94 274 94 288 C94 296 92 303 86 304 ' +
  'L72 305 C58 306 48 302 48 288 C48 274 49 258 50 238 L52 156 C54 132 74 122 100 122 Z';

/** Heads are their own lump, pressed down onto the body. */
const heads: Record<Head, string> = {
  round: 'M100 136 C71 136 50 113 50 85 C50 57 71 34 100 34 C129 34 150 57 150 85 C150 113 129 136 100 136 Z',
  tipLeft: 'M100 136 C70 136 50 114 50 88 C50 64 60 46 72 30 C77 22 80 16 84 13 C88 10 92 14 96 20 C102 28 108 33 116 38 C136 50 150 66 150 90 C150 116 130 136 100 136 Z',
  tipRight: 'M100 136 C70 136 50 114 50 88 C50 58 72 42 100 38 C116 35 128 27 138 15 C143 9 149 11 150 18 C152 34 151 52 151 68 C152 80 150 88 150 94 C148 118 128 136 100 136 Z',
  square: 'M100 138 C74 138 58 128 58 106 C58 98 53 92 53 82 L53 46 C53 36 61 29 72 29 L128 29 C139 29 147 36 147 46 L147 82 C147 92 142 98 142 106 C142 128 126 138 100 138 Z',
};

// 18 white keys; black keys sit after these white keys in each octave.
const whiteKeys = Array.from({ length: 18 }, (_, i) => -74 + i * (148 / 18));
const blackKeys = whiteKeys.slice(0, -1).filter((_, i) => [0, 1, 3, 4, 5].includes(i % 7));

/*
 * Plasticine for the bandmates and their instruments: the shape swells into
 * a plump rounded volume with a gentle undulation and faint fingerprint
 * smears pressed into it, lit softly from the top left, with a satin sheen
 * rather than a gloss.
 */
function sculpt(round: number, lumps = 0.12, prints = 0) {
  return `
  <feGaussianBlur in="SourceAlpha" stdDeviation="${round}" result="blur" />
  <feTurbulence type="fractalNoise" baseFrequency="0.02" numOctaves="3" seed="9" result="lumps" />
  <feComposite in="blur" in2="lumps" operator="arithmetic" k2="1" k3="${lumps}" result="lumpy" />
  <feTurbulence type="fractalNoise" baseFrequency="0.035 0.1" numOctaves="2" seed="5" result="prints" />
  <feComposite in="lumpy" in2="prints" operator="arithmetic" k2="1" k3="${prints}" result="height" />
  <feDiffuseLighting in="height" surfaceScale="${round}" diffuseConstant="1" lighting-color="#fff" result="diffuse">
    <feDistantLight azimuth="235" elevation="62" />
  </feDiffuseLighting>
  <feComposite in="SourceGraphic" in2="diffuse" operator="arithmetic" k1="1.12" result="shaded" />
  <feSpecularLighting in="height" surfaceScale="${round}" specularConstant="0.5" specularExponent="7" lighting-color="#fff" result="spec">
    <feDistantLight azimuth="235" elevation="52" />
  </feSpecularLighting>
  <feComposite in="spec" in2="SourceAlpha" operator="in" result="specIn" />
  <feComposite in="shaded" in2="specIn" operator="arithmetic" k2="1" k3="0.3" result="lit" />
  <feComposite in="lit" in2="SourceAlpha" operator="in" />
`;
}

const INST = 'url(#clay-inst)';
/** The bandmates' own clay: chunky body and head, smaller bits for faces and hands. */
const BODY = 'url(#clay-body)';
const BIT = 'url(#clay-bit)';
---

<section class="bab" aria-label="Build-a-Bandmate">
  <svg class="bab-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <!--
        Bounding boxes leave out stroke width, so the noodle arms (thick
        strokes) get a fixed region covering everywhere a hand can reach.
      -->
      <filter id="clay-arm" filterUnits="userSpaceOnUse" x="10" y="100" width="180" height="150" color-interpolation-filters="sRGB" set:html={sculpt(4.5)} />
      <filter id="clay-body" x="-10%" y="-10%" width="120%" height="120%" color-interpolation-filters="sRGB" set:html={sculpt(9, 0.1, 0.03)} />
      <filter id="clay-bit" x="-30%" y="-30%" width="160%" height="160%" color-interpolation-filters="sRGB" set:html={sculpt(2.5, 0.06)} />
      <filter id="clay-inst" x="-15%" y="-15%" width="130%" height="130%" color-interpolation-filters="sRGB" set:html={sculpt(3, 0.08)} />

      <!-- Instruments are drawn around their own origin; see PLACEMENTS in the script. -->
      <g id="inst-electric">
        <path filter={INST} d="M-34 -4 C-38 -22 -22 -28 -10 -20 C-2 -15 6 -16 12 -24 C20 -32 32 -24 26 -12 C22 -6 22 6 26 12 C32 24 20 32 12 24 C6 16 -2 15 -10 20 C-22 28 -38 22 -34 4 Z" fill="#e8202a" />
        <path d="M-24 -10 C-14 -16 4 -12 14 -14 L16 10 C4 12 -14 16 -24 10 Z" fill="#f2e4cc" />
        <rect x="-22" y="-6" width="4" height="12" rx="1" fill="#8c8c8c" />
        <rect x="-10" y="-6" width="4" height="12" rx="1" fill="#2e1f16" />
        <rect x="2" y="-6" width="4" height="12" rx="1" fill="#2e1f16" />
        <path filter={INST} d="M16 -3.5 L92 -3 L92 3 L16 3.5 Z" fill="#c98a5a" />
        <path filter={INST} d="M90 -4 C96 -9 106 -10 112 -6 C114 -2 110 1 106 0 L104 4 L90 4 Z" fill="#c98a5a" />
        <g stroke="#f2e4cc" stroke-width="0.8">{[30, 42, 53, 63, 72, 80, 87].map((x) => <line x1={x} y1="-3" x2={x} y2="3" />)}</g>
        <g stroke="#fff" stroke-width="0.5" opacity="0.75">{[-2, -0.7, 0.7, 2].map((y) => <line x1="-20" y1={y} x2="104" y2={y} />)}</g>
      </g>

      <g id="inst-bass">
        <path filter={INST} d="M-34 -4 C-38 -24 -22 -30 -8 -22 C0 -17 8 -18 16 -28 C26 -36 36 -26 28 -12 C24 -6 24 6 28 12 C34 24 20 32 12 24 C6 16 -2 17 -10 22 C-22 30 -38 22 -34 4 Z" fill="#0b7a72" />
        <path d="M-22 -12 C-12 -18 2 -14 10 -16 L12 12 C2 14 -12 18 -22 12 Z" fill="#f2e4cc" />
        <rect x="-24" y="-6" width="5" height="12" rx="1" fill="#8c8c8c" />
        <rect x="-6" y="-7" width="5" height="14" rx="1" fill="#2e1f16" />
        <path filter={INST} d="M18 -4 L112 -3.5 L112 3.5 L18 4 Z" fill="#c98a5a" />
        <path filter={INST} d="M110 -5 L128 -7 C132 -6 132 -1 128 0 L124 5 L110 5 Z" fill="#c98a5a" />
        <g fill="#c8c8c8">{[114, 118, 122, 126].map((x) => <circle cx={x} cy="-8" r="1.8" />)}</g>
        <g stroke="#f2e4cc" stroke-width="0.8">{[34, 49, 62, 74, 85, 95, 104].map((x) => <line x1={x} y1="-3.5" x2={x} y2="3.5" />)}</g>
        <g stroke="#fff" stroke-width="0.7" opacity="0.75">{[-2.4, -0.8, 0.8, 2.4].map((y) => <line x1="-22" y1={y} x2="122" y2={y} />)}</g>
      </g>

      <g id="inst-acoustic">
        <path filter={INST} d="M-36 0 C-36 -26 -12 -28 0 -18 C6 -24 28 -24 28 0 C28 24 6 24 0 18 C-12 28 -36 26 -36 0 Z" fill="#e8b46a" />
        <circle cx="8" cy="0" r="8.5" fill="none" stroke="#a8743a" stroke-width="1.5" />
        <circle cx="8" cy="0" r="6.5" fill="#2e1f16" />
        <rect x="-26" y="-7" width="5" height="14" rx="1.5" fill="#7a4a2a" />
        <path filter={INST} d="M24 -3.5 L92 -3 L92 3 L24 3.5 Z" fill="#7a4a2a" />
        <path filter={INST} d="M90 -4.5 L108 -6 C111 -6 111 6 108 6 L90 4.5 Z" fill="#7a4a2a" />
        <g stroke="#f2e4cc" stroke-width="0.8">{[36, 47, 57, 66, 74, 81, 87].map((x) => <line x1={x} y1="-3" x2={x} y2="3" />)}</g>
        <g stroke="#fff" stroke-width="0.5" opacity="0.8">{[-2.2, -1.3, -0.4, 0.4, 1.3, 2.2].map((y) => <line x1="-24" y1={y} x2="104" y2={y} />)}</g>
      </g>

      <g id="inst-banjo">
        <circle filter={INST} cx="0" cy="0" r="27" fill="#7a4a2a" />
        <circle cx="0" cy="0" r="23" fill="none" stroke="#c8c8c8" stroke-width="3.5" />
        <circle filter={INST} cx="0" cy="0" r="20.5" fill="#f6efe2" />
        <path d="M-20 -2 L-8 -2 L-8 2 L-20 2 Z" fill="#8c8c8c" />
        <rect x="2" y="-4" width="2.5" height="8" fill="#7a4a2a" />
        <path filter={INST} d="M22 -3 L106 -2.5 L106 2.5 L22 3 Z" fill="#7a4a2a" />
        <path filter={INST} d="M104 -4 L118 -6 C121 -5 121 5 118 6 L104 4 Z" fill="#7a4a2a" />
        <circle cx="56" cy="-5" r="2" fill="#f2e4cc" />
        <g stroke="#f2e4cc" stroke-width="0.8">{[34, 45, 55, 64, 72, 80, 87, 93].map((x) => <line x1={x} y1="-2.5" x2={x} y2="2.5" />)}</g>
        <g stroke="#fff" stroke-width="0.45" opacity="0.8">{[-1.8, -0.9, 0, 0.9, 1.8].map((y) => <line x1="-14" y1={y} x2="110" y2={y} />)}</g>
      </g>

      <g id="inst-piano">
        <g stroke="#2e1f16" stroke-width="7" stroke-linecap="round" filter={INST}>
          <line x1="-50" y1="14" x2="50" y2="92" />
          <line x1="50" y1="14" x2="-50" y2="92" />
        </g>
        <rect filter={INST} x="-81" y="-13" width="162" height="28" rx="7" fill="#4a4a4a" />
        <rect x="-74" y="-6" width="148" height="16" rx="2" fill="#fffaf0" />
        <g stroke="#c9ad85" stroke-width="0.8">{whiteKeys.slice(1).map((x) => <line x1={x} y1="-6" x2={x} y2="10" />)}</g>
        <g fill="#2e1f16">{blackKeys.map((x) => <rect x={x + 148 / 18 - 2.5} y="-6" width="5" height="9.5" rx="1" />)}</g>
        <circle cx="-74" cy="-9.5" r="1.6" fill="#ffd23f" />
        <circle cx="-68" cy="-9.5" r="1.6" fill="#e8202a" />
      </g>

      <g id="inst-drums">
        {/* Cymbals on tripod stands, behind everything. */}
        <g stroke="#9a9a9a" stroke-width="3.5" stroke-linecap="round" filter={INST}>
          <path d="M-72 -58 L-72 34 M-72 30 L-84 40 M-72 30 L-60 40" fill="none" />
          <path d="M68 -74 L68 34 M68 30 L56 40 M68 30 L80 40" fill="none" />
        </g>
        <g filter={INST} fill="#e8b830">
          <ellipse cx="-72" cy="-61" rx="25" ry="6" />
          <ellipse cx="68" cy="-77" rx="25" ry="6" transform="rotate(-8 68 -77)" />
        </g>
        <g filter={INST} fill="#d4a020">
          <circle cx="-72" cy="-65" r="4" />
          <circle cx="68" cy="-81" r="4" />
        </g>
        {/* Floor tom on the left, rack toms up top, all red with white heads. */}
        <g filter={INST}>
          <rect x="-66" y="-16" width="32" height="36" rx="5" fill="#e8202a" />
          <ellipse cx="-50" cy="-16" rx="16" ry="5" fill="#f6efe2" />
          <rect x="-26" y="-56" width="36" height="20" rx="4" fill="#e8202a" />
          <ellipse cx="-8" cy="-56" rx="18" ry="5.5" fill="#f6efe2" />
          <rect x="30" y="-42" width="34" height="20" rx="4" fill="#e8202a" />
          <ellipse cx="47" cy="-42" rx="17" ry="5" fill="#f6efe2" />
        </g>
        <g filter={INST} fill="#e8202a">
          <rect x="-26" y="34" width="8" height="10" rx="3" />
          <rect x="18" y="34" width="8" height="10" rx="3" />
        </g>
        <circle filter={INST} cx="0" cy="0" r="42" fill="#e8202a" />
        <circle filter={INST} cx="0" cy="0" r="34" fill="#f6efe2" />
        <text x="0" y="8" text-anchor="middle" font-family="Fredoka, 'Arial Rounded MT Bold', sans-serif" font-weight="700" font-size="22" fill="#d9440d">MBG*</text>
      </g>

      <!-- Drawn where they sit on a bandmate, not around an origin. -->
      <g id="inst-mic">
        <ellipse cx="138" cy="301" rx="24" ry="5" fill="#2e1f16" />
        <line x1="138" y1="160" x2="138" y2="300" stroke="#4a4a4a" stroke-width="4" stroke-linecap="round" />
        <rect x="133" y="154" width="10" height="9" rx="2" fill="#2e1f16" />
        <line filter={INST} x1="126" y1="140" x2="137" y2="157" stroke="#2e1f16" stroke-width="8" stroke-linecap="round" />
        <circle filter={INST} cx="121" cy="131" r="10.5" fill="#c8c8c8" />
        <path d="M113 127 L129 127 M112 132 L130 132 M114 137 L128 137 M117 122 L117 140 M121 121 L121 141 M125 122 L125 140" stroke="#8c8c8c" stroke-width="0.9" />
      </g>

      <g id="inst-harmonica">
        <rect filter={INST} x="82" y="104" width="36" height="15" rx="3" fill="#c8c8c8" />
        <rect x="83" y="109" width="34" height="5" fill="#7a4a2a" />
        <g fill="#2e1f16">{Array.from({ length: 8 }, (_, i) => <rect x={84.5 + i * 4.1} y="110" width="2.4" height="3" rx="0.6" />)}</g>
        <path d="M85 106.5 L115 106.5" stroke="#fffaf0" stroke-width="1.2" stroke-linecap="round" opacity="0.8" />
      </g>
    </defs>
  </svg>

  <div class="bab-stage clay">
    <ul class="bab-band" role="list">
      {members.map((m, i) => {
        return (
          <li>
            <button type="button" class="bab-player" data-player={i} data-name={m.name} aria-label={`${m.name}: empty-handed`}>
              <svg viewBox="0 0 200 320" aria-hidden="true" focusable="false" style={`--blink-delay: ${-i * 1.7}s`}>
                <defs>
                  {/* The arms drawn in front of the instruments fade in from the shoulder, so the shoulder itself comes from the blended lump. */}
                  {[0, 1].map((h) => (
                    <>
                      <linearGradient id={`bab-fade-${i}-${h}`} class="bab-fade" gradientUnits="userSpaceOnUse">
                        <stop offset="0" stop-color="#000" />
                        <stop offset="1" stop-color="#fff" />
                      </linearGradient>
                      <mask id={`bab-mask-${i}-${h}`} maskUnits="userSpaceOnUse" x="-60" y="-60" width="320" height="440">
                        <rect x="-60" y="-60" width="320" height="440" fill={`url(#bab-fade-${i}-${h})`} />
                      </mask>
                    </>
                  ))}
                </defs>
                <ellipse cx="100" cy="306" rx="64" ry="9" fill="rgba(70, 40, 20, 0.2)" />
                {/* Body, head and arms are one lump of clay, so the neck and shoulders blend. */}
                <g filter={BODY} fill={m.clay}>
                  <g class="bab-shape">
                    <path d={bodyPath} />
                    <path d={heads[m.head]} />
                  </g>
                  {[0, 1].map(() => (
                    <g class="bab-limb">
                      <path class="bab-arm-in" fill="none" stroke={m.clay} stroke-width="21" stroke-linecap="round" />
                      <ellipse class="bab-hand" rx="13.5" ry="12.5" />
                    </g>
                  ))}
                </g>
                <g class="bab-body">
                  {m.cap && (
                    <g filter={BIT}>
                      <path d="M53 70 C51 34 74 18 100 18 C126 18 149 34 147 70 Z" fill={m.cap[0]} />
                      <path d="M50 65 C76 56 128 56 158 67 C161 75 147 77 140 74 C120 69 82 69 56 74 C47 74 45 67 50 65 Z" fill={m.cap[1]} />
                      <circle cx="100" cy="19" r="4" fill={m.cap[1]} />
                    </g>
                  )}
                  {m.cap && (
                    <text x="100" y="52" text-anchor="middle" font-family="Fredoka, 'Arial Rounded MT Bold', sans-serif" font-weight="700" font-size="14" fill={m.cap[1]}>MBG*</text>
                  )}
                  {!m.cap && <path filter={BIT} d="M78 64 Q86 58 94 63 M104 63 Q112 58 120 64" fill="none" stroke={m.clay} stroke-width="5.5" stroke-linecap="round" />}
                  <g class="bab-eyes">
                    <ellipse filter={BIT} cx="88" cy="82" rx="11" ry="12.5" fill="#fffaf0" />
                    <ellipse filter={BIT} cx="113" cy="82" rx="11" ry="12.5" fill="#fffaf0" />
                    <circle filter={BIT} cx="91.5" cy="83" r="5.8" fill="#1e1410" />
                    <circle filter={BIT} cx="116.5" cy="83" r="5.8" fill="#1e1410" />
                    <circle cx="93.4" cy="80.6" r="1.7" fill="#fff" />
                    <circle cx="118.4" cy="80.6" r="1.7" fill="#fff" />
                  </g>
                  <circle filter={BIT} cx="101" cy="99" r="5" fill={m.clay} />
                  {/* A wide grin pressed into the clay. */}
                  <path class="bab-smile" d="M85 106 Q101 124 117 106 Q101 115 85 106 Z" fill="#1e1410" stroke="#1e1410" stroke-width="2" stroke-linejoin="round" />
                  <ellipse class="bab-sing" cx="101" cy="111" rx="8" ry="2" fill="#1e1410" visibility="hidden" />
                </g>
                <g class="bab-inst">
                  <path class="bab-strap" filter={BIT} d="M131 130 Q118 160 98 194" fill="none" stroke="#2e2622" stroke-width="8" stroke-linecap="round" visibility="hidden" />
                  <use href="" visibility="hidden" />
                </g>
                <g class="bab-arms">
                  {[0, 1].map((h) => (
                    <g class="bab-arm">
                      <g mask={`url(#bab-mask-${i}-${h})`}>
                        <g filter="url(#clay-arm)" fill={m.clay}>
                          <path class="bab-arm-in" fill="none" stroke={m.clay} stroke-width="21" stroke-linecap="round" />
                          <ellipse class="bab-hand" rx="13.5" ry="12.5" />
                        </g>
                      </g>
                      <line class="bab-stick" stroke="#dba468" stroke-width="6.5" stroke-linecap="round" visibility="hidden" />
                    </g>
                  ))}
                </g>
              </svg>
              <span class="bab-name">{m.name}</span>
            </button>
          </li>
        );
      })}
    </ul>
  </div>

  <div class="bab-tray" role="group" aria-label="Instruments">
    {instruments.map((inst) => (
      <button type="button" class="bab-inst-btn clay-button" data-inst={inst.id} aria-pressed="false">
        <svg viewBox={inst.icon} aria-hidden="true" focusable="false"><use href={`#inst-${inst.id}`} /></svg>
        <span>{inst.label}</span>
      </button>
    ))}
  </div>

  <div class="bab-controls">
    <button type="button" class="clay-button bab-play" aria-pressed="false">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path class="bab-play-icon" d="M7 4l13 8-13 8z" fill="currentColor" /></svg>
      <span>Play</span>
    </button>
    <button type="button" class="clay-button bab-shuffle">Shuffle</button>
    <button type="button" class="clay-button bab-clear">Clear</button>
  </div>
  <div class="bab-now" aria-hidden="true"></div>
  <div class="bab-status" role="status" aria-live="polite">Pick an instrument and tap a bandmate, or drag it right onto them. Then hit Play.</div>
</section>

<style>
  .bab {
    margin: 0 0 1.75rem;
  }

  .bab-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .bab-stage {
    --c: var(--paper);
    position: relative;
    padding: 1rem 0.75rem 0.5rem;
    overflow: hidden;
  }

  .bab-band {
    position: relative;
    list-style: none;
    margin: 0;
    /* Room for the last guitar neck sticking out to the right. */
    padding: 0 6% 0 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.25rem;
  }

  .bab-player {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding: 0 0 0.4rem;
    border: none;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    border-radius: var(--blob);
    -webkit-tap-highlight-color: transparent;
  }

  .bab-player svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    transition: transform 140ms ease;
    /* Standing just in front of the backdrop, like a stop-motion set. */
    filter: drop-shadow(5px 8px 7px rgba(70, 40, 20, 0.22));
  }

  .bab:has(.bab-inst-btn[aria-pressed="true"]) .bab-player:hover svg,
  .bab-player.is-target svg {
    transform: translateY(-4px) scale(1.04);
  }

  .bab-player.is-target {
    outline: 3px dashed var(--teal);
    outline-offset: -2px;
  }

  .bab-player.boing svg {
    animation: bab-boing 420ms ease;
  }

  @keyframes bab-boing {
    0% { transform: scale(1, 1); }
    30% { transform: scale(1.12, 0.86) translateY(14px); }
    60% { transform: scale(0.94, 1.08) translateY(-6px); }
    100% { transform: scale(1, 1); }
  }

  .bab-eyes {
    transform-box: fill-box;
    transform-origin: center;
    animation: bab-blink 5s infinite;
    animation-delay: var(--blink-delay, 0s);
  }

  @keyframes bab-blink {
    0%, 94%, 100% { transform: scaleY(1); }
    96% { transform: scaleY(0.1); }
  }

  .bab-name {
    --c: var(--cream);
    --c-deep: var(--cream-deep);
    --lift: 4px;
    margin-top: -0.25rem;
    padding: 0.15rem 0.6rem 0.1rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: var(--clay-texture) 0 0 / 240px, var(--c);
    background-blend-mode: soft-light, normal;
    border-radius: var(--blob);
    box-shadow:
      inset 2px 3px 4px rgba(255, 255, 255, 0.4),
      inset -2px -3px 5px rgba(0, 0, 0, 0.14),
      0 var(--lift) 0 var(--c-deep);
  }

  .bab-tray {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.9rem 0.6rem;
    margin: 1.6rem 0 0;
  }

  .bab-inst-btn {
    --c: var(--cream);
    --c-deep: var(--cream-deep);
    flex-direction: column;
    justify-content: center;
    gap: 0.25rem;
    padding: 0.5rem 0.35rem 0.4rem;
    color: var(--ink);
    font-size: 0.78rem;
    line-height: 1.1;
    text-align: center;
    touch-action: none;
  }

  .bab-inst-btn svg {
    width: 100%;
    height: 38px;
    overflow: visible;
    pointer-events: none;
  }

  .bab-inst-btn[aria-pressed="true"] {
    --c: var(--teal);
    --c-deep: var(--teal-deep);
    color: var(--cream);
    outline: 3px dashed var(--cream);
    outline-offset: -7px;
  }

  .bab-controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
    margin: 1.6rem 0 0.75rem;
  }

  .bab-play {
    --c: var(--orange);
    --c-deep: var(--orange-deep);
    font-size: 1.25rem;
    padding: 0.65rem 1.6rem 0.6rem;
  }

  .bab-shuffle,
  .bab-clear {
    --c: var(--cream);
    --c-deep: var(--cream-deep);
    color: var(--ink);
  }

  /* Where the band is in the song: section and chord. */
  .bab-now {
    min-height: 1.4em;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--teal);
  }

  .bab-status {
    min-height: 1.6em;
    text-align: center;
    font-size: 0.95rem;
  }

  .bab-ghost {
    position: fixed;
    z-index: 50;
    width: 96px;
    height: 64px;
    pointer-events: none;
    transform: translate(-50%, -60%) rotate(-8deg);
    filter: drop-shadow(0 8px 8px rgba(70, 40, 20, 0.3));
  }

  .bab-ghost svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  @media (max-width: 600px) {
    .bab-band {
      padding: 0;
      grid-template-columns: repeat(6, 1fr);
      row-gap: 0.4rem;
    }

    .bab-band li {
      grid-column: span 2;
    }

    .bab-band li:nth-child(4) {
      grid-column: 2 / span 2;
    }

    .bab-tray {
      gap: 0.7rem 0.45rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bab-eyes,
    .bab-player.boing svg {
      animation: none;
    }
  }
</style>

<script>
  import { bpm, sections, type Feel } from '../data/wake-up-call';

  type InstId = 'piano' | 'bass' | 'electric' | 'acoustic' | 'banjo' | 'drums' | 'mic' | 'harmonica';
  type Slung = 'electric' | 'acoustic' | 'bass' | 'banjo';
  interface Pt { x: number; y: number }

  const INSTRUMENTS: InstId[] = ['piano', 'bass', 'electric', 'acoustic', 'banjo', 'drums', 'mic', 'harmonica'];
  const LABELS: Record<InstId, string> = {
    piano: 'piano', bass: 'bass', electric: 'electric guitar', acoustic: 'acoustic guitar', banjo: 'banjo', drums: 'drums',
    mic: 'mic', harmonica: 'harmonica',
  };
  const STORAGE_KEY = 'mbg-bandmates';

  // ---------- Chords ----------

  const NOTES: Record<string, number> = { C: 0, D: 2, E: 4, F: 5, G: 7, A: 9, B: 11 };
  const QUALITIES: Record<string, number[]> = {
    '': [0, 4, 7], m: [0, 3, 7], min: [0, 3, 7], 5: [0, 7],
    7: [0, 4, 7, 10], m7: [0, 3, 7, 10], maj7: [0, 4, 7, 11], M7: [0, 4, 7, 11],
    6: [0, 4, 7, 9], m6: [0, 3, 7, 9], 9: [0, 4, 7, 10, 14], add9: [0, 4, 7, 14],
    sus: [0, 5, 7], sus2: [0, 2, 7], sus4: [0, 5, 7], dim: [0, 3, 6], aug: [0, 4, 8],
    '7sus2': [0, 2, 7, 10], '7sus4': [0, 5, 7, 10],
  };

  interface Voicing {
    /** Root pitch class, 0 = C. */
    pc: number;
    /** Every pitch class in the chord. */
    pcs: Set<number>;
    bass: number;
    piano: number[];
    power: number;
    strum: number[];
    banjo: number[];
  }

  const pitchClass = (letter: string, accidental: string) => (NOTES[letter] + (accidental === '#' ? 1 : accidental === 'b' ? -1 : 0) + 12) % 12;

  /** Turn a chord name like "Em", "D/F#" or "Cadd9" into notes for every instrument. */
  function voice(name: string): Voicing {
    const m = /^([A-G])([#b]?)([^/]*)(?:\/([A-G])([#b]?))?$/.exec(name.trim());
    if (!m) throw new Error(`Can't read chord "${name}"`);
    const pc = pitchClass(m[1], m[2]);
    const low = m[4] ? pitchClass(m[4], m[5]) : pc;
    const quality = m[3];
    const intervals = QUALITIES[quality] ?? (quality.startsWith('m') && !quality.startsWith('maj') ? QUALITIES.m : QUALITIES['']);
    const pcs = new Set(intervals.map((i) => (pc + i) % 12));
    const tonesIn = (from: number, to: number) => {
      const out: number[] = [];
      for (let n = from; n <= to; n++) if (pcs.has(n % 12)) out.push(n);
      return out;
    };
    const piano = [...new Set(intervals.map((i) => {
      let n = 48 + pc + i;
      while (n > 67) n -= 12;
      while (n < 52) n += 12;
      return n;
    }))].sort((a, b) => a - b);
    // Guitar: bass note on the low strings, then chord tones up the neck, six strings at most.
    const strumRoot = 40 + ((low - 4 + 12) % 12);
    return {
      pc,
      pcs,
      bass: 36 + low,
      piano,
      power: 40 + ((pc - 4 + 12) % 12),
      strum: [strumRoot, ...tonesIn(strumRoot + 5, strumRoot + 27).slice(0, 5)],
      banjo: tonesIn(62, 80).slice(0, 4),
    };
  }

  // ---------- The song, laid out in sixteenth notes ----------

  interface Note { len: number; midi: number }

  /** The chord and feel under each sixteenth note of the loop. */
  const CHART: { chord: Voicing; feel: Feel; next: Voicing }[] = [];
  /** Where each new chord lands, labelled for the readout. */
  const CHANGES = new Map<number, string>();
  /** The last step of each section, where the drummer fills. */
  const SECTION_ENDS = new Set<number>();
  /** Melody notes starting on each step: what the mics sing, and the harmonica's solos. */
  const VOCAL = new Map<number, Note>();
  const SOLO = new Map<number, Note>();

  function lay(into: Map<number, Note>, start: number, part: { melody: number[]; shift?: number; from?: number; to?: number }) {
    const { melody, shift = 0, from = -Infinity, to = Infinity } = part;
    const offset = Number.isFinite(from) ? from : 0;
    for (let i = 0; i < melody.length; i += 3) {
      const [at, len, midi] = [melody[i], melody[i + 1], melody[i + 2]];
      if (at >= from && at < to) into.set(start + at - offset, { len, midi: midi + shift });
    }
  }

  for (const section of sections) {
    const start = CHART.length;
    const names = section.chords.split(/\s+/);
    names.forEach((name, bar) => {
      const chord = voice(name);
      if (bar === 0 || name !== names[bar - 1]) CHANGES.set(CHART.length, `${section.name} · ${name}`);
      for (let i = 0; i < 16; i++) CHART.push({ chord, feel: section.feel, next: chord });
    });
    SECTION_ENDS.add(CHART.length - 1);
    if (section.vocal) lay(VOCAL, start, section.vocal);
    if (section.solo) lay(SOLO, start, section.solo);
  }
  const LOOP = CHART.length;
  // Each step also knows the chord coming next, for the bass's walk-ups.
  for (let i = 0; i < LOOP; i++) CHART[i].next = CHART[(i + 16 - (i % 16)) % LOOP].chord;
  const STEP = 60 / bpm / 4;

  /** The note sounding on each step (or null), for mouths and for the harmonica to find gaps. */
  function sounding(notes: Map<number, Note>) {
    const out: (number | null)[] = new Array(LOOP).fill(null);
    for (const [at, n] of notes) for (let i = 0; i < n.len; i++) out[(at + i + LOOP) % LOOP] = n.midi;
    return out;
  }
  const VOCAL_AT = sounding(VOCAL);
  const SOLO_AT = sounding(SOLO);

  /**
   * Harmony for the k-th mic: the melody, then the chord tones just above
   * and below it, then the next one up, then the melody an octave down.
   */
  function harmony(midi: number, chord: Voicing, k: number): number {
    if (k === 0) return midi;
    if (k === 4) return midi - 12;
    const up = (from: number) => {
      let n = from + 1;
      while (!chord.pcs.has(n % 12) || n - from < 3) n++;
      return n;
    };
    if (k === 1) return up(midi);
    if (k === 3) return up(up(midi));
    let n = midi - 1;
    while (!chord.pcs.has(n % 12) || midi - n < 3) n--;
    return n;
  }

  /** Rhythm patterns, by sixteenth within the bar, for each feel. */
  const GROOVES: Record<Feel, { kick: number[]; snare: number[]; hat: number[]; piano: number[]; electric: number[]; strum: Record<number, 'down' | 'up'>; banjo: number; bass: number[] }> = {
    full: {
      kick: [0, 8, 10], snare: [4, 12], hat: [0, 2, 4, 6, 8, 10, 12, 14],
      piano: [0, 6, 10], electric: [0, 2, 4, 6, 8, 10, 12, 14],
      strum: { 0: 'down', 4: 'down', 6: 'up', 10: 'up', 12: 'down', 14: 'up' }, banjo: 1, bass: [0, 4, 8, 12],
    },
    half: {
      kick: [0], snare: [8], hat: [0, 4, 8, 12],
      piano: [0, 8], electric: [0, 8],
      strum: { 0: 'down', 8: 'down', 14: 'up' }, banjo: 2, bass: [0, 8],
    },
    sparse: {
      kick: [0], snare: [], hat: [4, 8, 12],
      piano: [0], electric: [0],
      strum: { 0: 'down' }, banjo: 4, bass: [0],
    },
  };
  const ROLL = [1, 2, 3, 0, 2, 3, 1, 3];
  const TOMS = [200, 170, 140, 115];

  /** The drummer fills on the last beat of each section the band is in full swing for. */
  const isFill = (step: number) => {
    const end = [...SECTION_ENDS].find((e) => e >= step && e - step < 4);
    return end !== undefined && CHART[step].feel === 'full';
  };
  const FILL = Array.from({ length: LOOP }, (_, i) => isFill(i));

  /** The bass note for a step, or null: root on the beat, walking up to the next chord on beat four. */
  function bassNote(step: number): number | null {
    const { chord, feel, next } = CHART[step];
    const s = step % 16;
    if (!GROOVES[feel].bass.includes(s)) return null;
    if (s === 12 && feel === 'full') return next.pc === chord.pc ? chord.bass + 7 : next.bass - 1;
    return chord.bass;
  }

  const P = (x: number, y: number): Pt => ({ x, y });
  const lerp = (a: Pt, b: Pt, t: number): Pt => P(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t);
  const smooth = (t: number) => t * t * (3 - 2 * t);
  const wrap = (s: number) => ((s % LOOP) + LOOP) % LOOP;
  function rotate(p: Pt, deg: number): Pt {
    const r = (deg * Math.PI) / 180;
    return P(p.x * Math.cos(r) - p.y * Math.sin(r), p.x * Math.sin(r) + p.y * Math.cos(r));
  }

  // ---------- Poses ----------

  /**
   * Where each slung instrument hangs on a player, plus how its hands move:
   * the strumming hand rocks across the strings and the fretting hand
   * slides up the neck to wherever the chord's root is.
   */
  const SLUNG: Record<Slung, { at: Pt; rot: number; strum: Pt; amp: number; period: number; fret: (pc: number) => number }> = {
    electric: { at: P(78, 222), rot: -28, strum: P(-4, 0), amp: 9, period: 2, fret: (pc) => 46 + ((pc - 4 + 12) % 12) * 2.6 },
    acoustic: { at: P(76, 224), rot: -28, strum: P(6, 0), amp: 11, period: 4, fret: (pc) => 44 + ((pc - 4 + 12) % 12) * 2.4 },
    bass: { at: P(72, 226), rot: -30, strum: P(-6, 0), amp: 5, period: 4, fret: (pc) => 54 + ((pc - 4 + 12) % 12) * 3 },
    banjo: { at: P(78, 222), rot: -26, strum: P(-6, 4), amp: 3.5, period: 1, fret: (pc) => 44 + ((pc - 7 + 12) % 12) * 2.6 },
  };
  /** Sparse sections strum once a bar; half-time ones half as often. */
  const STRUM_SLOW: Record<Feel, number> = { full: 1, half: 2, sparse: 8 };
  const FIXED_AT: Record<'piano' | 'drums', Pt> = { piano: P(100, 200), drums: P(100, 262) };
  /** The kit is drawn a size up, so the drummer peeks over a proper set of drums. */
  const DRUM_SCALE = 1.3;
  const onKit = (x: number, y: number) => P(FIXED_AT.drums.x + x * DRUM_SCALE, FIXED_AT.drums.y + y * DRUM_SCALE);
  const SHOULDERS: [Pt, Pt] = [P(62, 150), P(138, 150)];
  const REST: [Pt, Pt] = [P(40, 218), P(160, 218)];
  const WAVE: [Pt, Pt] = [P(36, 116), P(164, 116)];
  const MIC_GRIP = P(131, 149);
  /** Bodies squash and lean from the feet. */
  const FEET = P(100, 304);
  /** Drummers sit down behind the kit. */
  const SEAT = 14;

  interface HandEvent { step: number; at: Pt }

  function hits(test: (step: number, s16: number) => boolean, at: (step: number) => Pt): HandEvent[] {
    const out: HandEvent[] = [];
    for (let step = 0; step < LOOP; step++) if (test(step, step % 16)) out.push({ step, at: at(step) });
    return out;
  }

  // Drums: stick tips land on these (world coordinates).
  const HIHAT = onKit(-70, -62);
  const SNARE = onKit(47, -43);
  const TOM = onKit(-8, -57);
  const CRASH = onKit(64, -78);
  const STICK: [Pt, Pt] = [P(-24, 12), P(24, 12)];
  const groove = (step: number) => GROOVES[CHART[step].feel];
  const sectionStart = (step: number) => SECTION_ENDS.has((step - 1 + LOOP) % LOOP);

  const DRUM_HANDS: [HandEvent[], HandEvent[]] = [
    // Left hand rides the hi-hat, then joins the tom fills.
    hits((step, s) => (FILL[step] ? s % 2 === 1 : groove(step).hat.includes(s)), (step) => (FILL[step] ? TOM : HIHAT)),
    // Right hand: crashes into each section, backbeat on the snare, toms in the fills.
    hits(
      (step, s) => sectionStart(step) || (FILL[step] ? s % 2 === 0 : groove(step).snare.includes(s)),
      (step) => (sectionStart(step) ? CRASH : FILL[step] ? TOM : SNARE),
    ),
  ];

  // Piano: left hand on the root, right hand comping, both moving up the keys with the chord.
  const PIANO_HANDS: [HandEvent[], HandEvent[]] = [
    hits((step, s) => CHANGES.has(step) || s === 0 || (s === 8 && CHART[step].feel !== 'sparse'), (step) => P(54 + CHART[step].chord.pc * 2, 194)),
    hits((step, s) => CHANGES.has(step) || groove(step).piano.includes(s), (step) => P(122 + CHART[step].chord.pc * 2 + (step % 16 === 6 ? 4 : 0), 194)),
  ];

  /** Where a hand is between hits: down on each hit, swinging up in between. */
  function between(events: HandEvent[], s: number): { at: Pt; lift: number } {
    const m = wrap(s);
    let i = events.length - 1;
    while (i >= 0 && events[i].step > m) i--;
    const last = i >= 0 ? events[i] : { ...events[events.length - 1], step: events[events.length - 1].step - LOOP };
    const nextRaw = events[(i + 1) % events.length];
    const next = i + 1 < events.length ? nextRaw : { ...nextRaw, step: nextRaw.step + LOOP };
    const gap = next.step - last.step;
    const frac = gap > 0 ? (m - last.step) / gap : 0;
    return { at: lerp(last.at, next.at, smooth(frac)), lift: Math.sin(Math.PI * frac) * Math.min(1, gap / 2) };
  }

  /** A squash-and-stretch lean from the feet, as a point mapper and an SVG transform. */
  function bodyMove(y: number, deg: number, sx: number, sy: number) {
    const map = (p: Pt) => {
      const r = rotate(P((p.x - FEET.x) * sx, (p.y - FEET.y) * sy), deg);
      return P(FEET.x + r.x, FEET.y + r.y + y);
    };
    const transform =
      `translate(0 ${y.toFixed(2)}) rotate(${deg.toFixed(2)} ${FEET.x} ${FEET.y}) ` +
      `translate(${FEET.x} ${FEET.y}) scale(${sx.toFixed(4)} ${sy.toFixed(4)}) translate(${-FEET.x} ${-FEET.y})`;
    return { map, transform };
  }

  /** Slung instruments are drawn a size up, chunky like the bandmates. */
  const SLUNG_SCALE = 1.4;

  function placeSlung(id: Slung, local: Pt): Pt {
    const g = SLUNG[id];
    const r = rotate(P(local.x * SLUNG_SCALE, local.y * SLUNG_SCALE), g.rot);
    return P(g.at.x + r.x, g.at.y + r.y);
  }

  // ---------- Players ----------

  interface Arm {
    /** The arm in front of the instruments and its copy blended into the body. */
    paths: SVGPathElement[];
    hands: SVGEllipseElement[];
    fade: SVGLinearGradientElement;
    stick: SVGLineElement;
  }

  interface Player {
    name: string;
    button: HTMLButtonElement;
    body: SVGGElement;
    shape: SVGGElement;
    instG: SVGGElement;
    use: SVGUseElement;
    strap: SVGPathElement;
    arm: [Arm, Arm];
    smile: SVGPathElement;
    sing: SVGEllipseElement;
    inst: InstId | null;
    /** A little personality in how each one grooves. */
    squash: number;
    lean: number;
  }

  const root = document.querySelector<HTMLElement>('.bab')!;
  const status = root.querySelector<HTMLElement>('.bab-status')!;
  const playBtn = root.querySelector<HTMLButtonElement>('.bab-play')!;
  const now = root.querySelector<HTMLElement>('.bab-now')!;
  const trayBtns = [...root.querySelectorAll<HTMLButtonElement>('.bab-inst-btn')];

  const players: Player[] = [...root.querySelectorAll<HTMLButtonElement>('.bab-player')].map((button, i) => {
    const limbs = [...button.querySelectorAll<SVGGElement>('.bab-limb')];
    const fades = [...button.querySelectorAll<SVGLinearGradientElement>('.bab-fade')];
    const arm = [...button.querySelectorAll<SVGGElement>('.bab-arm')].map((g, h) => ({
      paths: [g, limbs[h]].map((el) => el.querySelector<SVGPathElement>('.bab-arm-in')!),
      hands: [g, limbs[h]].map((el) => el.querySelector<SVGEllipseElement>('.bab-hand')!),
      fade: fades[h],
      stick: g.querySelector<SVGLineElement>('.bab-stick')!,
    })) as [Arm, Arm];
    return {
      name: button.dataset.name!,
      button,
      body: button.querySelector<SVGGElement>('.bab-body')!,
      shape: button.querySelector<SVGGElement>('.bab-shape')!,
      instG: button.querySelector<SVGGElement>('.bab-inst')!,
      use: button.querySelector<SVGUseElement>('.bab-inst use')!,
      strap: button.querySelector<SVGPathElement>('.bab-strap')!,
      arm,
      smile: button.querySelector<SVGPathElement>('.bab-smile')!,
      sing: button.querySelector<SVGEllipseElement>('.bab-sing')!,
      inst: null,
      squash: [0.05, 0.07, 0.04, 0.06, 0.08][i % 5],
      lean: [3, -4, 5, -3, 4][i % 5],
    };
  });

  const anyone = (inst: InstId) => players.some((p) => p.inst === inst);

  /**
   * What the harmonica plays on a step: its solos, the tune when nobody has
   * a mic, and little chord answers in the gaps between sung lines.
   */
  function harpNote(step: number): Note | null {
    const m = wrap(step);
    if (SOLO.has(m)) return SOLO.get(m)!;
    if (SOLO_AT[m] !== null) return null;
    if (!anyone('mic') && VOCAL.has(m)) return VOCAL.get(m)!;
    if (m % 4 !== 0) return null;
    for (let i = -1; i < 8; i++) if (VOCAL_AT[wrap(m + i)] !== null) return null;
    const tones = CHART[m].chord.piano.map((n) => n + 12);
    return { len: 3, midi: tones[[0, 1, 2, 1][(m / 4) % 4] % tones.length] };
  }

  /** The harmonica note sounding at song position s, for its slide along the lips. */
  function harpAt(s: number): number | null {
    const m = Math.floor(wrap(s));
    for (let i = 0; i < 16; i++) {
      const n = harpNote(m - i);
      if (n) return n.len > i ? n.midi : null;
    }
    return null;
  }

  function setArm(arm: Arm, shoulder: Pt, hand: Pt, outward: number) {
    const dx = hand.x - shoulder.x;
    const dy = hand.y - shoulder.y;
    const len = Math.hypot(dx, dy) || 1;
    // Noodle arms: the shorter the reach, the more the elbow bows out.
    const bend = Math.max(8, (84 - len) * 0.55);
    let n = P(-dy / len, dx / len);
    if (n.x * outward < 0) n = P(-n.x, -n.y);
    const ctrl = P((shoulder.x + hand.x) / 2 + n.x * bend, (shoulder.y + hand.y) / 2 + n.y * bend);
    const d = `M${shoulder.x.toFixed(1)} ${shoulder.y.toFixed(1)} Q${ctrl.x.toFixed(1)} ${ctrl.y.toFixed(1)} ${hand.x.toFixed(1)} ${hand.y.toFixed(1)}`;
    for (const p of arm.paths) p.setAttribute('d', d);
    for (const h of arm.hands) {
      h.setAttribute('cx', hand.x.toFixed(1));
      h.setAttribute('cy', hand.y.toFixed(1));
    }
    // Fade the front arm in over the first half, from just off the shoulder.
    const along = (t: number) => P(
      (1 - t) ** 2 * shoulder.x + 2 * (1 - t) * t * ctrl.x + t * t * hand.x,
      (1 - t) ** 2 * shoulder.y + 2 * (1 - t) * t * ctrl.y + t * t * hand.y,
    );
    const [a, b] = [along(0.15), along(0.5)];
    arm.fade.setAttribute('x1', a.x.toFixed(1));
    arm.fade.setAttribute('y1', a.y.toFixed(1));
    arm.fade.setAttribute('x2', b.x.toFixed(1));
    arm.fade.setAttribute('y2', b.y.toFixed(1));
  }

  /** Put a player in their pose at song position s (in sixteenth notes). */
  function pose(p: Player, s: number, playing: boolean) {
    const beat = (Math.PI * s) / 4;
    const k = playing ? p.squash * Math.abs(Math.sin(beat)) : 0;
    const steady = p.inst === 'drums' || p.inst === 'piano' || p.inst === 'mic';
    const lean = playing ? p.lean * Math.sin(beat / 2) * (steady ? 0.4 : 1) : 0;
    const move = bodyMove(p.inst === 'drums' ? SEAT : 0, lean, 1 + k * 0.7, 1 - k);
    const shoulders: [Pt, Pt] = [move.map(SHOULDERS[0]), move.map(SHOULDERS[1])];
    const hands: [Pt, Pt] = [move.map(REST[0]), move.map(REST[1])];
    const sticks: (Pt | null)[] = [null, null];
    let instTransform = '';
    let mouth = 0;

    if (p.inst === 'drums' || p.inst === 'piano') {
      const events = p.inst === 'drums' ? DRUM_HANDS : PIANO_HANDS;
      for (const h of [0, 1] as const) {
        const { at, lift } = playing ? between(events[h], s) : { at: events[h][0].at, lift: 0 };
        if (p.inst === 'drums') {
          // The hand sits back up the stick from where the tip lands.
          hands[h] = P(at.x - STICK[h].x, at.y - STICK[h].y - lift * 20);
          const tip = rotate(STICK[h], (h === 0 ? 1 : -1) * lift * 35);
          sticks[h] = P(hands[h].x + tip.x, hands[h].y + tip.y);
        } else {
          hands[h] = P(at.x, at.y - lift * 12);
        }
      }
    } else if (p.inst === 'mic') {
      // One hand on the mic; the other reaches out while they sing.
      const m = Math.floor(wrap(s));
      const singing = playing && VOCAL_AT[m] !== null;
      hands[1] = MIC_GRIP;
      hands[0] = singing ? move.map(P(44, 168 - 6 * Math.sin(beat))) : hands[0];
      if (singing) {
        let start = m;
        while (!VOCAL.has(start) && m - start < 16) start--;
        mouth = 0.45 + 0.55 * Math.exp(-(wrap(s) - start) * 0.5);
      }
    } else if (p.inst === 'harmonica') {
      // Both hands cupped round it; it slides along the lips with the tune.
      const midi = playing ? harpAt(s) : null;
      const slide = midi === null ? 0 : Math.max(-8, Math.min(8, (67 - midi) * 1.2));
      const wah = midi === null ? 0 : 3 * Math.sin(Math.PI * s);
      instTransform = `${move.transform} translate(${slide.toFixed(2)} 0)`;
      hands[0] = move.map(P(80 + slide, 113));
      hands[1] = move.map(P(121 + slide + wah * 0.5, 113 + wah));
    } else if (p.inst) {
      const g = SLUNG[p.inst];
      const t = playing ? s : 0;
      const period = g.period * STRUM_SLOW[CHART[Math.floor(wrap(t))].feel];
      const strum = g.amp * Math.cos((2 * Math.PI * t) / period);
      hands[0] = move.map(placeSlung(p.inst, P(g.strum.x + (p.inst === 'bass' ? strum * 0.6 : 0), g.strum.y + strum)));
      // Slide to the next chord during the sixteenth before it lands.
      const m = wrap(t);
      const here = g.fret(CHART[Math.floor(m)].chord.pc);
      const next = g.fret(CHART[(Math.floor(m) + 1) % LOOP].chord.pc);
      const fret = here + (next - here) * smooth(m % 1);
      hands[1] = move.map(placeSlung(p.inst, P(fret + (playing ? 1.5 * Math.sin(Math.PI * t) : 0), 5)));
      instTransform = move.transform;
    } else if (playing) {
      // Nothing to play, so dance: arms up and down, one after the other.
      const up = (Math.sin(beat) + 1) / 2;
      hands[0] = move.map(lerp(REST[0], WAVE[0], up));
      hands[1] = move.map(lerp(REST[1], WAVE[1], 1 - up));
    }

    p.body.setAttribute('transform', move.transform);
    p.shape.setAttribute('transform', move.transform);
    p.instG.setAttribute('transform', instTransform);
    setArm(p.arm[0], shoulders[0], hands[0], -1);
    setArm(p.arm[1], shoulders[1], hands[1], 1);
    for (const h of [0, 1] as const) {
      const stick = p.arm[h].stick;
      const tip = sticks[h];
      stick.setAttribute('visibility', tip ? 'visible' : 'hidden');
      if (tip) {
        stick.setAttribute('x1', hands[h].x.toFixed(1));
        stick.setAttribute('y1', hands[h].y.toFixed(1));
        stick.setAttribute('x2', tip.x.toFixed(1));
        stick.setAttribute('y2', tip.y.toFixed(1));
      }
    }
    p.smile.setAttribute('visibility', mouth ? 'hidden' : 'visible');
    p.sing.setAttribute('visibility', mouth ? 'visible' : 'hidden');
    if (mouth) p.sing.setAttribute('ry', (2 + 7 * mouth).toFixed(2));
  }

  function give(p: Player, inst: InstId | null) {
    p.inst = inst;
    p.use.setAttribute('href', inst ? `#inst-${inst}` : '');
    p.use.setAttribute('visibility', inst ? 'visible' : 'hidden');
    p.strap.setAttribute('visibility', inst && inst in SLUNG ? 'visible' : 'hidden');
    if (inst === 'drums' || inst === 'piano') {
      p.use.setAttribute('transform', `translate(${FIXED_AT[inst].x} ${FIXED_AT[inst].y})${inst === 'drums' ? ` scale(${DRUM_SCALE})` : ''}`);
    } else if (inst === 'mic' || inst === 'harmonica' || !inst) {
      p.use.removeAttribute('transform');
    } else {
      const g = SLUNG[inst];
      p.use.setAttribute('transform', `translate(${g.at.x} ${g.at.y}) rotate(${g.rot}) scale(${SLUNG_SCALE})`);
    }
    p.button.setAttribute('aria-label', `${p.name}: ${inst ? LABELS[inst] : 'empty-handed'}`);
    if (!band.playing) for (const q of players) pose(q, 0, false);
  }

  function boing(p: Player) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    p.button.classList.remove('boing');
    void p.button.offsetWidth;
    p.button.classList.add('boing');
  }

  function save() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(players.map((p) => p.inst)));
    } catch {}
  }

  function load() {
    try {
      const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
      if (Array.isArray(saved)) {
        saved.forEach((inst, i) => {
          if (players[i] && INSTRUMENTS.includes(inst)) give(players[i], inst);
        });
      }
    } catch {}
  }

  // ---------- Sound ----------

  const midiHz = (m: number) => 440 * 2 ** ((m - 69) / 12);

  /** Vowel formants (Hz) for the clay choir. */
  const VOWELS = {
    oo: [320, 800, 2500],
    ah: [750, 1150, 2600],
    oh: [450, 820, 2700],
  };

  class Band {
    ctx: AudioContext | null = null;
    out!: GainNode;
    noise!: AudioBuffer;
    curve!: Float32Array<ArrayBuffer>;
    plucks = new Map<string, AudioBuffer>();
    playing = false;
    t0 = 0;
    step = 0;
    timer = 0;

    private init() {
      const AC = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      const ctx = (this.ctx = new AC());
      const comp = ctx.createDynamicsCompressor();
      this.out = ctx.createGain();
      this.out.gain.value = 0.6;
      this.out.connect(comp).connect(ctx.destination);
      this.noise = ctx.createBuffer(1, ctx.sampleRate, ctx.sampleRate);
      const n = this.noise.getChannelData(0);
      for (let i = 0; i < n.length; i++) n[i] = Math.random() * 2 - 1;
      this.curve = new Float32Array(1024);
      for (let i = 0; i < 1024; i++) {
        const x = (i / 1023) * 2 - 1;
        this.curve[i] = Math.tanh(x * 6);
      }
    }

    start() {
      if (!this.ctx) this.init();
      const ctx = this.ctx!;
      void ctx.resume();
      this.t0 = ctx.currentTime + 0.08;
      this.step = 0;
      this.playing = true;
      this.tick();
    }

    stop() {
      this.playing = false;
      clearTimeout(this.timer);
    }

    /** Song position in sixteenth notes. */
    position() {
      return this.ctx ? Math.max(0, (this.ctx.currentTime - this.t0) / STEP) : 0;
    }

    private tick = () => {
      const ctx = this.ctx!;
      while (this.t0 + this.step * STEP < ctx.currentTime + 0.12) {
        this.play(this.step, this.t0 + this.step * STEP);
        this.step++;
      }
      this.timer = window.setTimeout(this.tick, 25);
    };

    private env(t: number, peak: number, decay: number, attack = 0.004, into: AudioNode = this.out): GainNode {
      const g = this.ctx!.createGain();
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(peak, t + attack);
      g.gain.exponentialRampToValueAtTime(0.0001, t + attack + decay);
      g.connect(into);
      return g;
    }

    private osc(type: OscillatorType, hz: number, t: number, dur: number, into: AudioNode, detune = 0) {
      const o = this.ctx!.createOscillator();
      o.type = type;
      o.frequency.value = hz;
      o.detune.value = detune;
      o.connect(into);
      o.start(t);
      o.stop(t + dur + 0.05);
      return o;
    }

    private hiss(t: number, dur: number, filter: BiquadFilterType, hz: number, into: AudioNode, q = 0.7) {
      const ctx = this.ctx!;
      const src = ctx.createBufferSource();
      src.buffer = this.noise;
      const f = ctx.createBiquadFilter();
      f.type = filter;
      f.frequency.value = hz;
      f.Q.value = q;
      src.connect(f).connect(into);
      src.start(t, Math.random() * 0.5);
      src.stop(t + dur + 0.05);
    }

    private kick(t: number, gain = 0.9) {
      const o = this.osc('sine', 150, t, 0.4, this.env(t, gain, 0.38, 0.002));
      o.frequency.setValueAtTime(150, t);
      o.frequency.exponentialRampToValueAtTime(42, t + 0.12);
    }

    private tom(t: number, hz: number) {
      const o = this.osc('sine', hz, t, 0.35, this.env(t, 0.6, 0.32, 0.002));
      o.frequency.exponentialRampToValueAtTime(hz * 0.6, t + 0.25);
    }

    /** Karplus–Strong: a burst of noise that rings round a short delay loop like a plucked string. */
    private pluck(t: number, midi: number, kind: 'acoustic' | 'banjo', gain: number) {
      const ctx = this.ctx!;
      const key = `${kind}${midi}`;
      let buf = this.plucks.get(key);
      if (!buf) {
        const banjo = kind === 'banjo';
        const sr = ctx.sampleRate;
        const len = Math.floor(sr * (banjo ? 0.8 : 1.8));
        const period = Math.max(2, Math.round(sr / midiHz(midi)));
        buf = ctx.createBuffer(1, len, sr);
        const out = buf.getChannelData(0);
        const ring = new Float32Array(period);
        let prev = 0;
        for (let i = 0; i < period; i++) {
          prev = (banjo ? 0.9 : 0.55) * (Math.random() * 2 - 1) + (banjo ? 0.1 : 0.45) * prev;
          ring[i] = prev;
        }
        const decay = banjo ? 0.985 : 0.996;
        for (let i = 0, j = 0; i < len; i++) {
          const k = (j + 1) % period;
          out[i] = ring[j];
          ring[j] = decay * 0.5 * (ring[j] + ring[k]);
          j = k;
        }
        this.plucks.set(key, buf);
      }
      const src = ctx.createBufferSource();
      src.buffer = buf;
      const g = ctx.createGain();
      g.gain.value = gain;
      src.connect(g).connect(this.out);
      src.start(t);
    }

    /**
     * A clay choir voice: a buzzy tone with vibrato through three vowel
     * formants. The lead opens "oo" into "ah" on every note, like singing
     * "wah"; harmonies stay rounder.
     */
    private sing(t: number, midi: number, dur: number, lead: boolean, pan: number) {
      const ctx = this.ctx!;
      const hz = midiHz(midi);
      const o = ctx.createOscillator();
      o.type = 'sawtooth';
      o.frequency.setValueAtTime(hz * 0.97, t);
      o.frequency.linearRampToValueAtTime(hz, t + 0.05);
      const lfo = ctx.createOscillator();
      lfo.frequency.value = 5.5;
      const depth = ctx.createGain();
      depth.gain.setValueAtTime(0, t);
      depth.gain.linearRampToValueAtTime(hz * 0.008, t + Math.min(dur, 0.35));
      lfo.connect(depth).connect(o.frequency);

      const amp = ctx.createGain();
      const peak = lead ? 0.28 : 0.18;
      amp.gain.setValueAtTime(0.0001, t);
      amp.gain.exponentialRampToValueAtTime(peak, t + 0.03);
      amp.gain.setValueAtTime(peak, t + Math.max(0.03, dur - 0.05));
      amp.gain.exponentialRampToValueAtTime(0.0001, t + dur + 0.08);
      const panner = ctx.createStereoPanner();
      panner.pan.value = pan;
      amp.connect(panner).connect(this.out);

      const from = VOWELS.oo;
      const to = lead ? VOWELS.ah : VOWELS.oh;
      [1, 0.5, 0.25].forEach((gain, i) => {
        const f = ctx.createBiquadFilter();
        f.type = 'bandpass';
        f.Q.value = 6 + i * 3;
        f.frequency.setValueAtTime(from[i], t);
        f.frequency.linearRampToValueAtTime(to[i], t + 0.08);
        const g = ctx.createGain();
        g.gain.value = gain * 3;
        o.connect(f).connect(g).connect(amp);
      });
      o.start(t);
      lfo.start(t);
      o.stop(t + dur + 0.1);
      lfo.stop(t + dur + 0.1);
    }

    /** Harmonica: two slightly beating reeds through a cupped-hands filter, with a little hand wah. */
    private harp(t: number, midi: number, dur: number) {
      const ctx = this.ctx!;
      const f = ctx.createBiquadFilter();
      f.type = 'bandpass';
      f.frequency.value = 1500;
      f.Q.value = 0.9;
      const wah = ctx.createGain();
      wah.gain.value = 0.75;
      const lfo = ctx.createOscillator();
      lfo.frequency.value = 5;
      const lfoDepth = ctx.createGain();
      lfoDepth.gain.value = 0.25;
      lfo.connect(lfoDepth).connect(wah.gain);
      const amp = ctx.createGain();
      amp.gain.setValueAtTime(0.0001, t);
      amp.gain.exponentialRampToValueAtTime(0.16, t + 0.025);
      amp.gain.setValueAtTime(0.16, t + Math.max(0.025, dur - 0.04));
      amp.gain.exponentialRampToValueAtTime(0.0001, t + dur + 0.06);
      f.connect(wah).connect(amp).connect(this.out);
      this.osc('square', midiHz(midi), t, dur + 0.06, f, -5);
      this.osc('sawtooth', midiHz(midi), t, dur + 0.06, f, 5);
      lfo.start(t);
      lfo.stop(t + dur + 0.1);
    }

    /** Schedule one sixteenth note. Only instruments somebody is holding make a sound. */
    private play(step: number, t: number) {
      const active = new Set(players.map((p) => p.inst));
      const s = step % 16;
      const m = step % LOOP;
      const { chord, feel } = CHART[m];
      const g = GROOVES[feel];
      const change = CHANGES.has(m);
      const first = sectionStart(m);

      if (active.has('drums')) {
        if (g.kick.includes(s)) this.kick(t, feel === 'sparse' ? 0.5 : 0.9);
        if (FILL[m]) this.tom(t, TOMS[m % 4]);
        else {
          if (g.snare.includes(s)) {
            this.hiss(t, 0.18, 'highpass', 1200, this.env(t, feel === 'half' ? 0.25 : 0.45, 0.16, 0.002));
            this.osc('triangle', 185, t, 0.1, this.env(t, 0.3, 0.09, 0.002));
          }
          if (g.hat.includes(s)) this.hiss(t, 0.05, 'highpass', 7500, this.env(t, feel === 'full' && s % 4 ? 0.12 : 0.18, 0.045, 0.002));
        }
        if (first && feel !== 'sparse') this.hiss(t, 1.4, 'highpass', 5000, this.env(t, 0.28, 1.3, 0.002));
      }

      const bass = active.has('bass') ? bassNote(m) : null;
      if (bass !== null) {
        const ctx = this.ctx!;
        const f = ctx.createBiquadFilter();
        f.type = 'lowpass';
        f.Q.value = 3;
        f.frequency.setValueAtTime(1400, t);
        f.frequency.exponentialRampToValueAtTime(380, t + 0.2);
        const len = feel === 'full' ? 0.3 : feel === 'half' ? 0.9 : 1.4;
        f.connect(this.env(t, 0.42, len, 0.006));
        this.osc('sawtooth', midiHz(bass), t, len, f);
        this.osc('sine', midiHz(bass), t, len, f);
      }

      if (active.has('piano') && (g.piano.includes(s) || change)) {
        const big = s === 0 || change;
        const notes = big ? chord.piano : chord.piano.map((n) => n + 12);
        const lh = big || (s === 8 && feel !== 'sparse') ? [chord.bass + 12] : [];
        for (const n of [...notes, ...lh]) {
          const decay = big ? (feel === 'full' ? 1.6 : 2.4) : 0.6;
          this.osc('triangle', midiHz(n), t, decay, this.env(t, big ? 0.16 : 0.1, decay, 0.005));
          this.osc('sine', midiHz(n) * 2, t, decay, this.env(t, 0.04, decay * 0.6, 0.005));
        }
      }

      if (active.has('electric') && g.electric.includes(s)) {
        const ctx = this.ctx!;
        const shaper = ctx.createWaveShaper();
        shaper.curve = this.curve;
        shaper.oversample = '2x';
        const f = ctx.createBiquadFilter();
        f.type = 'lowpass';
        f.frequency.value = 2400;
        const long = change || feel !== 'full';
        const len = feel === 'sparse' ? 1.8 : long ? 0.9 : 0.16;
        shaper.connect(f).connect(this.env(t, long ? 0.18 : 0.13, len, 0.004));
        const pre = ctx.createGain();
        pre.gain.value = 0.35;
        pre.connect(shaper);
        for (const n of [chord.power, chord.power + 7, chord.power + 12]) {
          this.osc('sawtooth', midiHz(n), t, len + 0.04, pre, -7);
          this.osc('sawtooth', midiHz(n), t, len + 0.04, pre, 7);
        }
      }

      if (active.has('acoustic') && s in g.strum) {
        const up = g.strum[s] === 'up';
        const strings = up ? chord.strum.slice(-4).reverse() : chord.strum;
        strings.forEach((n, i) => this.pluck(t + i * (feel === 'sparse' ? 0.03 : 0.012), n, 'acoustic', up ? 0.06 : 0.09));
      }

      if (active.has('banjo') && s % g.banjo === 0) {
        this.pluck(t, chord.banjo[ROLL[(s / g.banjo) % 8] % chord.banjo.length], 'banjo', s % 8 === 0 ? 0.3 : 0.2);
      }

      // Every mic sings the tune at once; extra mics take harmonies, spread across the stereo.
      const sung = VOCAL.get(m);
      if (sung) {
        const mics = players.filter((p) => p.inst === 'mic');
        mics.forEach((_, k) => {
          const pan = mics.length > 1 ? (k % 2 ? 1 : -1) * Math.min(0.6, 0.2 * Math.ceil(k / 2) + 0.1) : 0;
          this.sing(t, harmony(sung.midi, chord, k), sung.len * STEP * 0.95, k === 0, k === 0 ? 0 : pan);
        });
      }

      if (active.has('harmonica')) {
        const n = harpNote(m);
        if (n) this.harp(t, n.midi + (n.midi < 60 ? 12 : 0), n.len * STEP * 0.92);
      }
    }
  }

  const band = new Band();
  let frame = 0;
  let shown = '';

  /** Stop-motion is shot "on twos": pose the clay about 15 times a second, not every screen refresh. */
  const FRAME_MS = 1000 / 15;
  let lastPose = -Infinity;

  function animate(time: number) {
    frame = requestAnimationFrame(animate);
    if (time - lastPose < FRAME_MS) return;
    lastPose = time;
    const s = band.position();
    for (const p of players) pose(p, s, true);
    const step = Math.floor(wrap(s));
    const label = CHANGES.get(step);
    if (label && label !== shown) now.textContent = shown = label;
  }

  function setPlaying(on: boolean) {
    if (on === band.playing) return;
    if (on && !players.some((p) => p.inst)) {
      status.textContent = 'Nobody has an instrument yet! Hand somebody something first.';
      return;
    }
    if (on) {
      band.start();
      frame = requestAnimationFrame(animate);
      status.textContent = 'Take it away!';
    } else {
      band.stop();
      cancelAnimationFrame(frame);
      now.textContent = shown = '';
      for (const p of players) pose(p, 0, false);
    }
    playBtn.setAttribute('aria-pressed', String(on));
    playBtn.querySelector('span')!.textContent = on ? 'Stop' : 'Play';
    playBtn.querySelector('.bab-play-icon')!.setAttribute('d', on ? 'M6 5h4v14H6zM14 5h4v14h-4z' : 'M7 4l13 8-13 8z');
  }

  // ---------- Handing out instruments ----------

  let selected: InstId | null = null;

  function select(inst: InstId | null) {
    selected = inst;
    for (const b of trayBtns) b.setAttribute('aria-pressed', String(b.dataset.inst === inst));
    if (inst) status.textContent = `Who gets the ${LABELS[inst]}? Tap a bandmate.`;
  }

  function handTo(p: Player, inst: InstId) {
    // Handing someone what they're already holding takes it back.
    if (p.inst === inst) {
      give(p, null);
      status.textContent = `${p.name} put down the ${LABELS[inst]}.`;
    } else {
      give(p, inst);
      const mics = players.filter((q) => q.inst === 'mic').length;
      status.textContent =
        inst === 'mic' && mics > 1 ? `${p.name} grabbed a mic. ${mics} voices means harmonies!` : `${p.name} picked up the ${LABELS[inst]}.`;
    }
    boing(p);
    save();
  }

  for (const p of players) {
    p.button.addEventListener('click', () => {
      if (selected) handTo(p, selected);
      else if (p.inst) status.textContent = `${p.name} is on ${LABELS[p.inst]}. Pick an instrument to swap it.`;
      else status.textContent = `Pick an instrument for ${p.name} first.`;
    });
  }

  // Drag an instrument from the tray straight onto someone.
  let drag: { inst: InstId; id: number; x: number; y: number; ghost: HTMLElement | null; over: Player | null } | null = null;
  let suppressClick = false;

  const playerAt = (x: number, y: number) => {
    const el = document.elementFromPoint(x, y)?.closest<HTMLElement>('.bab-player');
    return el ? players[Number(el.dataset.player)] : null;
  };

  for (const b of trayBtns) {
    const inst = b.dataset.inst as InstId;
    b.addEventListener('click', () => {
      if (suppressClick) {
        suppressClick = false;
        return;
      }
      select(selected === inst ? null : inst);
    });
    b.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      drag = { inst, id: e.pointerId, x: e.clientX, y: e.clientY, ghost: null, over: null };
      b.setPointerCapture(e.pointerId);
    });
    b.addEventListener('pointermove', (e) => {
      if (!drag || drag.id !== e.pointerId) return;
      if (!drag.ghost) {
        if (Math.hypot(e.clientX - drag.x, e.clientY - drag.y) < 8) return;
        drag.ghost = document.createElement('div');
        drag.ghost.className = 'bab-ghost';
        drag.ghost.appendChild(b.querySelector('svg')!.cloneNode(true));
        root.appendChild(drag.ghost);
      }
      drag.ghost.style.left = `${e.clientX}px`;
      drag.ghost.style.top = `${e.clientY}px`;
      const over = playerAt(e.clientX, e.clientY);
      if (over !== drag.over) {
        drag.over?.button.classList.remove('is-target');
        over?.button.classList.add('is-target');
        drag.over = over;
      }
    });
    const end = (e: PointerEvent) => {
      if (!drag || drag.id !== e.pointerId) return;
      if (drag.ghost) {
        drag.ghost.remove();
        drag.over?.button.classList.remove('is-target');
        const target = e.type === 'pointerup' ? playerAt(e.clientX, e.clientY) : null;
        if (target) {
          handTo(target, drag.inst);
          select(null);
        }
        suppressClick = true;
        setTimeout(() => (suppressClick = false), 0);
      }
      drag = null;
    };
    b.addEventListener('pointerup', end);
    b.addEventListener('pointercancel', end);
  }

  root.querySelector('.bab-shuffle')!.addEventListener('click', () => {
    const deck = [...INSTRUMENTS].sort(() => Math.random() - 0.5);
    players.forEach((p, i) => {
      give(p, deck[i]);
      boing(p);
    });
    select(null);
    status.textContent = 'New lineup!';
    save();
  });

  root.querySelector('.bab-clear')!.addEventListener('click', () => {
    for (const p of players) give(p, null);
    select(null);
    status.textContent = 'Everybody put their instruments down.';
    save();
  });

  playBtn.addEventListener('click', () => setPlaying(!band.playing));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') select(null);
  });

  // Background tabs throttle timers, which makes the band trip over itself.
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) setPlaying(false);
  });

  for (const p of players) pose(p, 0, false);
  load();
</script>
