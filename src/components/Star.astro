---
/** The MBG* asterisk mark: eight rounded arms, drawn in currentColor. */
interface Props {
  class?: string;
  size?: number;
}

const { class: className, size = 32 } = Astro.props;
const arms = [0, 45, 90, 135];
---

<svg class:list={['star', className]} viewBox="0 0 100 100" width={size} height={size} aria-hidden="true">
  <g stroke="currentColor" stroke-width="17" stroke-linecap="round">
    {arms.map((deg) => <line x1="50" y1="12" x2="50" y2="88" transform={`rotate(${deg} 50 50)`} />)}
  </g>
</svg>
