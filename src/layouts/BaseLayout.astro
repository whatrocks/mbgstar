---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Money Back Guarantee*',
  description = 'Money Back Guarantee*'
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '');
const navLinks = [
  { href: '/shows', label: 'Shows' },
  { href: '/music', label: 'Music' },
  { href: '/about', label: 'About' }
];

/*
 * A span of the Golden Gate for the top of the footer: two towers, the
 * main cable sagging between them and the side spans running off the
 * edges, with suspenders hung every 24 units down to the deck.
 */
const W = 1200;
const DECK = 78;
const TOP = 6;
const towers = [170, 1030];
const sag = 64;
const cableY = (x: number) => {
  const [a, b] = towers;
  const side = DECK - 22 - TOP;
  if (x < a) return TOP + side * ((a - x) / a) ** 1.4;
  if (x > b) return TOP + side * ((x - b) / (W - b)) ** 1.4;
  const t = (x - (a + b) / 2) / ((b - a) / 2);
  return TOP + (sag - TOP) * (1 - t * t);
};
const cable = Array.from({ length: W / 10 + 1 }, (_, i) => {
  const x = i * 10;
  return `${i ? 'L' : 'M'}${x} ${cableY(x).toFixed(1)}`;
}).join(' ');
const suspenders = Array.from({ length: W / 24 - 1 }, (_, i) => (i + 1) * 24)
  .filter((x) => towers.every((t) => Math.abs(x - t) > 8))
  .map((x) => `M${x} ${cableY(x).toFixed(1)} V${DECK}`)
  .join(' ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#061b1e" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;700&display=swap"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a href="/" class="brand" aria-label="Money Back Guarantee* home">
          <img class="cube" src="/mbg-cube.webp" alt="" width="96" height="96" />
          <span class="brand-name">Money Back Guarantee<span>*</span></span>
        </a>
        <nav class="site-nav" aria-label="Main">
          {navLinks.map((link) => (
            <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>{link.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <svg class="bridge-span" viewBox={`0 0 ${W} 90`} preserveAspectRatio="none" aria-hidden="true">
        <g fill="none" stroke="currentColor" vector-effect="non-scaling-stroke">
          <path d={suspenders} stroke-width="1" opacity="0.7" vector-effect="non-scaling-stroke" />
          <path d={cable} stroke-width="2.5" vector-effect="non-scaling-stroke" />
          <path d={`M0 ${DECK} H${W}`} stroke-width="4" vector-effect="non-scaling-stroke" />
          {towers.map((x) => (
            <path d={`M${x - 7} 0 V90 M${x + 7} 0 V90 M${x - 7} 14 H${x + 7} M${x - 7} 36 H${x + 7} M${x - 7} 58 H${x + 7}`} stroke-width="3" vector-effect="non-scaling-stroke" />
          ))}
        </g>
      </svg>
      <div class="wrap">
        <div>
          <h2 class="footer-title">Stay in<br />the loop<span>*</span></h2>
          <nav class="social-links" aria-label="Social media">
            <a class="button" href="https://instagram.com/moneybackguaranteeasterisk" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
              <span>Instagram</span>
            </a>
            <a class="button" href="https://youtube.com/@moneybackguaranteeasterisk" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path>
                <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
              </svg>
              <span>YouTube</span>
            </a>
            <a class="button" href="https://mbgstar.bandcamp.com" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path d="M2 18l6-12h14L16 18H2z"></path>
              </svg>
              <span>Bandcamp</span>
            </a>
          </nav>
        </div>
        <div class="mailing-list frame">
          <iframe
            src="https://moneybackguarantee.substack.com/embed"
            title="Subscribe to Money Back Guarantee* on Substack"
            width="100%"
            height="320"
            frameborder="0"
            scrolling="no"
          ></iframe>
        </div>
        <p class="colophon">Money Back Guarantee* · Marin County &amp; the East Bay</p>
      </div>
    </footer>
    <script>
      let spaceHeld = false;
      document.addEventListener('keydown', (e) => {
        const t = e.target as HTMLElement | null;
        if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
        if (e.code === 'Space') {
          spaceHeld = true;
          return;
        }
        if ((e.key === 'm' || e.key === 'M') && spaceHeld) {
          e.preventDefault();
          document.body.classList.toggle('music-mode');
        }
      });
      document.addEventListener('keyup', (e) => {
        if (e.code === 'Space') spaceHeld = false;
      });
      window.addEventListener('blur', () => { spaceHeld = false; });
    </script>
  </body>
</html>
