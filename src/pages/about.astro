---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About — Money Back Guarantee*">
  <section class="banner halftone">
    <img src="/band-duotone.webp" alt="Money Back Guarantee* playing under their banner" width="2400" height="1800" />
    <h1 class="banner-title">About</h1>
  </section>

  <section class="section section--strip">
    <div class="wrap about">
      <p class="about-lede">
        A band of dads from Marin County and the East Bay, playing originals
        and covers after bedtime.
      </p>
      <p class="about-copy">
        Always ready to rock, as long as the dishes are done, the dog's walked,
        and the laundry's running.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .banner {
    display: grid;
    height: clamp(20rem, 55vw, 36rem);
    overflow: hidden;
    background: var(--teal);
  }

  .banner > * {
    grid-area: 1 / 1;
  }

  .banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }

  .banner-title {
    position: relative;
    z-index: 2;
    align-self: end;
    padding: 0 var(--gutter) clamp(1.5rem, 4vw, 2.5rem);
    color: var(--white);
    font-size: clamp(5rem, 18vw, 11rem);
    text-align: center;
  }

  .about {
    max-width: 52rem;
  }

  .about-lede {
    margin: 0 0 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
  }

  .about-copy {
    margin: 0 auto;
    max-width: 34rem;
    font-size: clamp(1.15rem, 2.4vw, 1.35rem);
  }

</style>
