---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatShowStart, upcomingShows } from '../data/shows';
import { featuredVideos } from '../data/videos';

const [firstVideo] = featuredVideos;
const embedUrl = (id: string) => `https://www.youtube-nocookie.com/embed/${id}?enablejsapi=1&rel=0`;
---

<BaseLayout>
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="section-label">Now showing</p>
      <h1 class="page-title page-title--plain" id="video-title">{firstVideo.title}</h1>
      <p class="lede">A band of dads from Marin County and the East Bay, playing originals and covers once the kids are asleep.</p>
      <div class="hero-actions">
        <a class="button button--primary" href="https://mbgstar.bandcamp.com" target="_blank" rel="noopener noreferrer">Listen on Bandcamp</a>
        <a class="button" href="/shows">See shows</a>
      </div>
    </div>
    <div class="hero-media">
      <div class="hero-video frame">
        <iframe
          id="video-player"
          src={embedUrl(firstVideo.youtubeId)}
          title={`${firstVideo.title} by Money Back Guarantee*`}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>
      <div class="video-picker" role="group" aria-label="Choose a video">
        {featuredVideos.map((video, i) => (
          <button
            type="button"
            class="video-pick"
            data-id={video.youtubeId}
            data-title={video.title}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            <span class="video-pick-num">{String(i + 1).padStart(2, '0')}</span>
            {video.title}
          </button>
        ))}
      </div>
    </div>
  </section>

  {upcomingShows.length > 0 && (
    <section class="upcoming wrap" style="--accent: var(--amber)">
      <h2 class="section-label">Upcoming shows</h2>
      <ul class="show-list">
        {upcomingShows.map((show) => (
          <li>
            <span class="show-date">{formatShowStart(show.start)}</span>
            <span class="show-venue">
              <span class="show-name">{show.venue}</span>
              {show.detail && <span class="show-detail">{show.detail}</span>}
            </span>
          </li>
        ))}
      </ul>
      <a class="button upcoming-more" href="/shows">All shows</a>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 5fr 7fr;
    align-items: center;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .hero .page-title {
    margin-bottom: 1.5rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Sized so every title fits in two lines and the layout holds still. */
  .hero .page-title {
    min-height: 1.76em;
    font-size: clamp(3rem, 7vw, 5.5rem);
  }

  /* Lit from the water: a sea-green glow and a hard orange edge. */
  .hero-video {
    box-shadow: 0 0 0 1px rgba(92, 191, 179, 0.25), 0 30px 80px rgba(47, 143, 138, 0.25), 0 30px 60px rgba(0, 0, 0, 0.6);
    border-bottom: 3px solid var(--bridge);
  }

  .hero-video iframe {
    aspect-ratio: 16 / 9;
    height: auto;
    border: 0;
  }

  .video-picker {
    display: flex;
    margin-top: 1rem;
    border-top: 1px solid var(--line);
  }

  /* A tab per video; the playing one gets a colored bar on top. */
  .video-pick {
    --accent: var(--bridge-hot);
    position: relative;
    flex: 1;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.9rem 0 0.25rem;
    background: none;
    border: 0;
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 1.1rem;
    text-transform: uppercase;
    text-align: left;
    cursor: pointer;
    transition: color 150ms ease;
  }

  .video-pick:nth-child(2) { --accent: var(--amber); }
  .video-pick:nth-child(3) { --accent: var(--sea); }
  .video-pick:nth-child(4) { --accent: var(--foam); }

  .video-pick::before {
    content: "";
    position: absolute;
    top: -2px;
    left: 0;
    right: 1rem;
    height: 3px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms ease;
  }

  .video-pick:hover,
  .video-pick[aria-pressed="true"] {
    color: var(--ink);
  }

  .video-pick[aria-pressed="true"]::before {
    transform: scaleX(1);
  }

  .video-pick-num {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--accent);
  }

  .upcoming {
    margin-top: clamp(3rem, 8vw, 6rem);
  }

  .upcoming-more {
    margin-top: 1.75rem;
  }

  /* Music mode: just the video. */
  :global(body.music-mode) .hero {
    display: block;
    width: min(960px, 90vw);
    padding: 0;
  }

  :global(body.music-mode) .hero-copy,
  :global(body.music-mode) .video-picker,
  :global(body.music-mode) .upcoming {
    display: none;
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero .page-title {
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .video-pick,
    .video-pick::before {
      transition: none;
    }
  }
</style>

<script>
  /*
   * Plays the featured videos in turn: when one ends the next starts, and
   * the last loops back to the first. The tabs jump straight to a video.
   */
  interface YTPlayer {
    loadVideoById(id: string): void;
  }

  interface YTNamespace {
    Player: new (
      el: HTMLIFrameElement,
      opts: { events: { onStateChange: (e: { data: number }) => void } }
    ) => YTPlayer;
    PlayerState: { ENDED: number };
  }

  const iframe = document.getElementById('video-player') as HTMLIFrameElement | null;
  const title = document.getElementById('video-title');
  const picks = [...document.querySelectorAll<HTMLButtonElement>('.video-pick')];

  if (iframe && title && picks.length > 1) {
    let current = 0;
    let player: YTPlayer | null = null;

    const play = (index: number) => {
      current = index;
      const pick = picks[index];
      const id = pick.dataset.id!;
      title.textContent = pick.dataset.title!;
      iframe.title = `${pick.dataset.title} by Money Back Guarantee*`;
      picks.forEach((p, i) => p.setAttribute('aria-pressed', String(i === index)));

      if (player) {
        player.loadVideoById(id);
      } else {
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?enablejsapi=1&rel=0&autoplay=1`;
      }
    };

    picks.forEach((pick, i) => pick.addEventListener('click', () => play(i)));

    const w = window as unknown as { YT?: YTNamespace; onYouTubeIframeAPIReady?: () => void };
    w.onYouTubeIframeAPIReady = () => {
      const YT = w.YT!;
      player = new YT.Player(iframe, {
        events: {
          onStateChange: (e) => {
            if (e.data === YT.PlayerState.ENDED) play((current + 1) % picks.length);
          }
        }
      });
    };

    const api = document.createElement('script');
    api.src = 'https://www.youtube.com/iframe_api';
    document.head.append(api);
  }
</script>
