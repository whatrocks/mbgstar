---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShowList from '../components/ShowList.astro';
import { upcomingShows } from '../data/shows';
import { heroVideo } from '../data/videos';

const { youtubeId, title, startSeconds = 0 } = heroVideo;

/*
 * Muted autoplay is the only kind browsers allow without a tap, and
 * playsinline keeps iOS from jumping to its fullscreen player. It starts
 * at startSeconds, and the script below loops it back there (YouTube's own
 * loop=1 would go back to 0:00). With no controls it reads as a backdrop;
 * the button below handles sound.
 */
const params = new URLSearchParams({
  enablejsapi: '1',
  origin: Astro.url.origin,
  autoplay: '1',
  mute: '1',
  playsinline: '1',
  start: String(startSeconds),
  controls: '0',
  fs: '0',
  rel: '0',
  modestbranding: '1',
  iv_load_policy: '3',
  disablekb: '1'
});
const embedUrl = `https://www.youtube-nocookie.com/embed/${youtubeId}?${params}`;
---

<BaseLayout>
  <section class="hero" aria-label="Featured video">
    <div class="hero-video">
      <iframe
        id="video-player"
        data-start={startSeconds}
        src={embedUrl}
        title={`${title} by Money Back Guarantee*`}
        allow="autoplay; encrypted-media"
        referrerpolicy="strict-origin-when-cross-origin"
        tabindex="-1"
      ></iframe>
      <img
        class="hero-poster"
        id="hero-poster"
        src={`https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg`}
        onerror={`this.onerror=null;this.src='https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg'`}
        alt=""
        fetchpriority="high"
      />
    </div>
    <button class="sound-toggle" id="sound-toggle" type="button" aria-pressed="false" disabled>
      <svg class="icon-muted" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" aria-hidden="true">
        <path d="M11 5 6 9H2v6h4l5 4V5z" fill="currentColor" stroke="none" />
        <path d="m23 9-6 6M17 9l6 6" />
      </svg>
      <svg class="icon-sound" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" aria-hidden="true">
        <path d="M11 5 6 9H2v6h4l5 4V5z" fill="currentColor" stroke="none" />
        <path d="M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14" />
      </svg>
      <span class="sound-label">Tap for sound</span>
    </button>
  </section>

  {upcomingShows.length > 0 && (
    <section class="section section--strip upcoming">
      <div class="wrap">
        <h2 class="section-title">Shows</h2>
        <ShowList shows={upcomingShows} origin={Astro.url.origin} />
        <a class="button button--black all-shows" href="/shows">All shows</a>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* ---------- Hero: the video, filling the screen under the header ---------- */

  .hero {
    position: relative;
    height: calc(100svh - var(--header));
    min-height: 20rem;
    overflow: hidden;
    background: var(--ink);
  }

  /*
   * Cover, like object-fit for an image: the iframe is scaled so the 16:9
   * picture fills the box whatever its shape, and the overflow is cropped.
   */
  .hero-video {
    position: absolute;
    inset: 0;
    container-type: size;
    pointer-events: none;
  }

  .hero-video iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(100cqw, 177.78cqh);
    height: max(100cqh, 56.25cqw);
    border: 0;
    transform: translate(-50%, -50%);
  }

  /*
   * The thumbnail sits over the player until the video is actually
   * playing, so YouTube's own play button and loading spinner never show.
   * If a browser refuses to autoplay, the still stays.
   */
  .hero-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 600ms ease;
  }

  .hero.is-playing .hero-poster {
    opacity: 0;
  }

  .sound-toggle {
    position: absolute;
    right: var(--gutter);
    bottom: var(--gutter);
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 1.1rem 0.6rem 0.9rem;
    border: 3px solid var(--white);
    background: var(--ink);
    color: var(--white);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 1.6rem);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 150ms ease, border-color 150ms ease, opacity 150ms ease;
  }

  .sound-toggle:hover {
    border-color: var(--orange);
    background: var(--orange);
  }

  .sound-toggle:disabled {
    opacity: 0;
    pointer-events: none;
  }

  .sound-toggle svg {
    display: block;
    flex: none;
  }

  .sound-toggle .icon-sound,
  .sound-toggle[aria-pressed="true"] .icon-muted {
    display: none;
  }

  .sound-toggle[aria-pressed="true"] .icon-sound {
    display: block;
  }

  /* Once the sound is on, the button shrinks to just its icon. */
  .sound-toggle[aria-pressed="true"] {
    padding: 0.55rem;
  }

  .sound-toggle[aria-pressed="true"] .sound-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---------- Shows ---------- */

  .all-shows {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
  }

  /* Music mode: just the video, the whole screen. */
  :global(body.music-mode) .hero {
    width: 100%;
    height: 100svh;
  }

  :global(body.music-mode) .upcoming {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-poster,
    .sound-toggle {
      transition: none;
    }
  }
</style>

<script>
  /*
   * This loops the video back to its start point (data-start), keeps it
   * going, lifts the still off it once it's playing, and runs the sound
   * button.
   */
  interface YTPlayer {
    playVideo(): void;
    seekTo(seconds: number, allowSeekAhead: boolean): void;
    mute(): void;
    unMute(): void;
    setVolume(volume: number): void;
  }

  interface YTNamespace {
    Player: new (
      el: HTMLIFrameElement,
      opts: {
        events: {
          onReady: () => void;
          onStateChange: (e: { data: number }) => void;
        };
      }
    ) => YTPlayer;
    PlayerState: { ENDED: number; PLAYING: number; PAUSED: number };
  }

  const hero = document.querySelector<HTMLElement>('.hero');
  const iframe = document.getElementById('video-player') as HTMLIFrameElement | null;
  const toggle = document.getElementById('sound-toggle') as HTMLButtonElement | null;

  if (hero && iframe && toggle) {
    let player: YTPlayer | null = null;
    const start = Number(iframe.dataset.start) || 0;
    let soundOn = false;

    const label = toggle.querySelector('.sound-label');
    const showSound = () => {
      toggle.setAttribute('aria-pressed', String(soundOn));
      if (label) label.textContent = soundOn ? 'Mute' : 'Tap for sound';
    };

    // A tap is also what a browser that blocked autoplay is waiting for.
    toggle.addEventListener('click', () => {
      if (!player) return;
      soundOn = !soundOn;
      if (soundOn) {
        player.unMute();
        player.setVolume(100);
      } else {
        player.mute();
      }
      player.playVideo();
      showSound();
    });

    const w = window as unknown as { YT?: YTNamespace; onYouTubeIframeAPIReady?: () => void };
    w.onYouTubeIframeAPIReady = () => {
      const YT = w.YT!;
      player = new YT.Player(iframe, {
        events: {
          onReady: () => {
            toggle.disabled = false;
            player!.mute();
            player!.playVideo();
          },
          onStateChange: (e) => {
            if (e.data === YT.PlayerState.PLAYING) {
              hero.classList.add('is-playing');
            } else if (e.data === YT.PlayerState.ENDED) {
              player!.seekTo(start, true);
              player!.playVideo();
            } else if (e.data === YT.PlayerState.PAUSED) {
              // An ambient video doesn't stay paused (iOS pauses it when
              // the tab is backgrounded, for one).
              player!.playVideo();
            }
          }
        }
      });
    };

    const api = document.createElement('script');
    api.src = 'https://www.youtube.com/iframe_api';
    document.head.append(api);
  }
</script>
