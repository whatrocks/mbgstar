---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatShowStart, upcomingShows } from '../data/shows';
---

<BaseLayout>
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="section-label">Latest video</p>
      <h1 class="page-title">After<br />Bedtime</h1>
      <p class="lede">A band of dads from Marin County and the East Bay, playing originals and covers once the kids are asleep.</p>
      <div class="hero-actions">
        <a class="button" href="https://mbgstar.bandcamp.com" target="_blank" rel="noopener noreferrer">Listen on Bandcamp</a>
        <a class="button" href="/shows" style="--accent: var(--green)">See shows</a>
      </div>
    </div>
    <div class="hero-video frame">
      <iframe
        src="https://www.youtube-nocookie.com/embed/PkiwIzlOOww"
        title="Money Back Guarantee* on YouTube"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>
  </section>

  {upcomingShows.length > 0 && (
    <section class="upcoming wrap" style="--accent: var(--yellow)">
      <h2 class="section-label">Upcoming shows</h2>
      <ul class="show-list">
        {upcomingShows.map((show) => (
          <li>
            <span class="show-date">{formatShowStart(show.start)}</span>
            <span class="show-venue">
              <span class="show-name">{show.venue}</span>
              {show.detail && <span class="show-detail">{show.detail}</span>}
            </span>
          </li>
        ))}
      </ul>
      <a class="button upcoming-more" href="/shows">All shows</a>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 5fr 7fr;
    align-items: center;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .hero .page-title {
    margin-bottom: 1.5rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-video {
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6);
  }

  .hero-video iframe {
    aspect-ratio: 16 / 9;
    height: auto;
    border: 0;
  }

  .upcoming {
    margin-top: clamp(3rem, 8vw, 6rem);
  }

  .upcoming-more {
    margin-top: 1.75rem;
  }

  /* Music mode: just the video. */
  :global(body.music-mode) .hero {
    display: block;
    width: min(960px, 90vw);
    padding: 0;
  }

  :global(body.music-mode) .hero-copy,
  :global(body.music-mode) .upcoming {
    display: none;
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }
</style>
