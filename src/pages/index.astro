---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShowList from '../components/ShowList.astro';
import { upcomingShows } from '../data/shows';
import { featuredVideos } from '../data/videos';

const [firstVideo] = featuredVideos;
const embedUrl = (id: string) => `https://www.youtube-nocookie.com/embed/${id}?enablejsapi=1&rel=0`;
---

<BaseLayout>
  <section class="hero">
    <img
      class="hero-art"
      src="/mbg-clay.webp"
      alt="MBG* in clay letters"
      width="1016"
      height="504"
    />
    <div class="hero-actions">
      <a class="button button--black" href="https://mbgstar.bandcamp.com" target="_blank" rel="noopener noreferrer">Listen now</a>
      <a class="button button--black" href="/shows">See shows</a>
    </div>
  </section>

  <section class="section section--strip music">
    <div class="wrap">
      <h2 class="section-title">Music</h2>
      <div class="carousel">
        <button class="carousel-arrow" type="button" data-step="-1" aria-label="Previous video">
          <svg viewBox="0 0 24 48" width="28" height="56" aria-hidden="true"><path d="M22 2 2 24l20 22" fill="none" stroke="currentColor" stroke-width="3" /></svg>
        </button>
        <div class="carousel-video">
          <iframe
            id="video-player"
            src={embedUrl(firstVideo.youtubeId)}
            title={`${firstVideo.title} by Money Back Guarantee*`}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </div>
        <button class="carousel-arrow" type="button" data-step="1" aria-label="Next video">
          <svg viewBox="0 0 24 48" width="28" height="56" aria-hidden="true"><path d="m2 2 20 22L2 46" fill="none" stroke="currentColor" stroke-width="3" /></svg>
        </button>
      </div>
      <h3 class="video-title" id="video-title" aria-live="polite">{firstVideo.title}</h3>
      <p class="byline">Money Back Guarantee*</p>
      <a class="button button--black listen" href="https://mbgstar.bandcamp.com" target="_blank" rel="noopener noreferrer">Listen now</a>
    </div>
  </section>

  {upcomingShows.length > 0 && (
    <section class="section water upcoming">
      <div class="wrap">
        <h2 class="section-title">Shows</h2>
        <ShowList shows={upcomingShows} origin={Astro.url.origin} />
        <a class="button button--white all-shows" href="/shows">All shows</a>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* ---------- Hero: the clay letters, straight on the cream ---------- */

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    padding: 1rem var(--gutter) clamp(2rem, 4vw, 2.75rem);
  }

  /*
   * Its backdrop is the page's cream. The backdrop isn't perfectly flat,
   * so the outer few percent fade out and no edge shows. The letters move
   * across nearly the whole frame, which rules out cropping it tighter.
   */
  /* Art, buttons and all come to about a third of the screen. */
  .hero-art {
    display: block;
    width: min(100%, 60rem, 50svh);
    height: auto;
    -webkit-mask-image:
      linear-gradient(to right, transparent, #000 9%, #000 91%, transparent),
      linear-gradient(to bottom, transparent, #000 12%, #000 88%, transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent, #000 9%, #000 91%, transparent),
      linear-gradient(to bottom, transparent, #000 12%, #000 88%, transparent);
    mask-composite: intersect;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .hero-actions .button {
    min-width: 15rem;
  }

  /* ---------- Music: one video at a time, arrows either side ---------- */

  .carousel {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(0.75rem, 3vw, 2rem);
    max-width: 52rem;
    margin: 0 auto;
  }

  .carousel-video iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    border: 0;
    background: var(--ink);
  }

  .carousel-arrow {
    display: grid;
    place-items: center;
    padding: 0.5rem;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
    transition: color 150ms ease, transform 150ms ease;
  }

  .carousel-arrow:hover {
    color: var(--orange);
  }

  .carousel-arrow[hidden] {
    display: none;
  }

  .carousel-arrow[data-step="-1"]:hover { transform: translateX(-3px); }
  .carousel-arrow[data-step="1"]:hover { transform: translateX(3px); }

  .video-title {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    font-size: clamp(3rem, 9vw, 5rem);
  }

  .listen {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
  }

  /* ---------- Shows on the water ---------- */

  .all-shows {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
  }

  /* Music mode: just the video. */
  :global(body.music-mode) .music {
    width: min(960px, 90vw);
    padding: 0;
    border: 0;
  }

  :global(body.music-mode) .hero,
  :global(body.music-mode) .upcoming,
  :global(body.music-mode) .section-title,
  :global(body.music-mode) .carousel-arrow,
  :global(body.music-mode) .video-title,
  :global(body.music-mode) .byline,
  :global(body.music-mode) .listen {
    display: none;
  }

  :global(body.music-mode) .carousel {
    display: block;
    max-width: none;
  }

  @media (max-width: 560px) {
    /* Edge to edge, and only as tall as it needs to be. */
    .hero {
      min-height: 0;
      padding: 1.5rem var(--gutter) 3rem;
    }

    .hero-art {
      width: calc(100% + 2 * var(--gutter));
      max-width: none;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .carousel {
      gap: 0.25rem;
    }

    .carousel-arrow {
      padding: 0.25rem;
    }

    .carousel-arrow svg {
      width: 18px;
      height: 36px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-arrow {
      transition: none;
    }
  }
</style>

<script>
  import { featuredVideos } from '../data/videos';

  /*
   * Plays the featured videos in turn: when one ends the next starts, and
   * the last loops back to the first. The arrows step through them.
   */
  interface YTPlayer {
    loadVideoById(id: string): void;
  }

  interface YTNamespace {
    Player: new (
      el: HTMLIFrameElement,
      opts: { events: { onStateChange: (e: { data: number }) => void } }
    ) => YTPlayer;
    PlayerState: { ENDED: number };
  }

  const iframe = document.getElementById('video-player') as HTMLIFrameElement | null;
  const title = document.getElementById('video-title');
  const arrows = [...document.querySelectorAll<HTMLButtonElement>('.carousel-arrow')];

  if (iframe && title && featuredVideos.length > 1) {
    let current = 0;
    let player: YTPlayer | null = null;

    const play = (index: number) => {
      current = (index + featuredVideos.length) % featuredVideos.length;
      const video = featuredVideos[current];
      title.textContent = video.title;
      iframe.title = `${video.title} by Money Back Guarantee*`;

      if (player) {
        player.loadVideoById(video.youtubeId);
      } else {
        iframe.src = `https://www.youtube-nocookie.com/embed/${video.youtubeId}?enablejsapi=1&rel=0&autoplay=1`;
      }
    };

    arrows.forEach((arrow) =>
      arrow.addEventListener('click', () => play(current + Number(arrow.dataset.step)))
    );

    const w = window as unknown as { YT?: YTNamespace; onYouTubeIframeAPIReady?: () => void };
    w.onYouTubeIframeAPIReady = () => {
      const YT = w.YT!;
      player = new YT.Player(iframe, {
        events: {
          onStateChange: (e) => {
            if (e.data === YT.PlayerState.ENDED) play(current + 1);
          }
        }
      });
    };

    const api = document.createElement('script');
    api.src = 'https://www.youtube.com/iframe_api';
    document.head.append(api);
  } else {
    arrows.forEach((arrow) => (arrow.hidden = true));
  }
</script>
