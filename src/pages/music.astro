---
import BaseLayout from '../layouts/BaseLayout.astro';

const videos: { id: string; title?: string }[] = [
  { id: 'PkiwIzlOOww', title: 'Wake-Up Call' },
  { id: 'Ls7FF78T6MI' },
  { id: 'jKuIO9XvSKI', title: 'Sunny Day' }
];
---

<BaseLayout title="Music — Money Back Guarantee*">
  <div class="wrap">
    <h1 class="page-title">Music</h1>
    <div class="video-grid">
      {videos.map((video) => (
        <div class="frame">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${video.id}?rel=0`}
            title={video.title ? `${video.title} by Money Back Guarantee*` : 'Money Back Guarantee* video'}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </div>
      ))}
      <a class="bandcamp" href="https://mbgstar.bandcamp.com" target="_blank" rel="noopener noreferrer">
        <span class="tag">Bandcamp</span>
        <span class="bandcamp-title">Take it home<span>*</span></span>
        <span class="bandcamp-cta">Listen &amp; buy →</span>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .video-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
  }

  /* The first video plays the lead, full width. */
  .video-grid > :first-child {
    grid-column: 1 / -1;
    box-shadow: 14px 14px 0 var(--maple), 0 24px 50px -20px rgba(15, 58, 60, 0.45);
  }

  .video-grid iframe {
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    border: 0;
  }

  .bandcamp {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding: 2rem;
    border-radius: calc(var(--radius) * 0.75);
    background: var(--sun);
    text-decoration: none;
    transition: transform 200ms ease;
  }

  .bandcamp:hover {
    transform: rotate(-1.5deg);
  }

  .bandcamp .tag {
    margin: 0;
  }

  .bandcamp-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 3.5rem);
    font-weight: 900;
    font-style: italic;
    font-variation-settings: "SOFT" 100, "WONK" 1;
    line-height: 0.95;
  }

  .bandcamp-title span {
    color: var(--paper);
  }

  .bandcamp-cta {
    font-weight: 700;
  }

  @media (max-width: 760px) {
    .video-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bandcamp {
      transition: none;
    }
  }
</style>
