---
import BaseLayout from '../layouts/BaseLayout.astro';

const videos: { id: string; title?: string }[] = [
  { id: 'PkiwIzlOOww', title: 'Wake-Up Call' },
  { id: 'jKuIO9XvSKI', title: 'Sunny Day' },
  { id: 'Ls7FF78T6MI' }
];
---

<BaseLayout title="Music — Money Back Guarantee*">
  <section class="section section--strip">
    <div class="wrap">
      <h1 class="section-title">Music</h1>
      <div class="videos">
        {videos.map((video) => (
          <figure>
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${video.id}?rel=0`}
              title={video.title ? `${video.title} by Money Back Guarantee*` : 'Money Back Guarantee* video'}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
            {video.title && (
              <figcaption>
                <span class="video-title">{video.title}</span>
                <span class="byline">Money Back Guarantee*</span>
              </figcaption>
            )}
          </figure>
        ))}
      </div>
      <a class="button button--black listen" href="https://mbgstar.bandcamp.com" target="_blank" rel="noopener noreferrer">Listen now</a>
    </div>
  </section>
</BaseLayout>

<style>
  .videos {
    display: flex;
    flex-direction: column;
    gap: clamp(3.5rem, 8vw, 5.5rem);
    max-width: 52rem;
    margin: 0 auto;
  }

  figure {
    margin: 0;
  }

  iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    border: 0;
    background: var(--ink);
  }

  figcaption {
    display: flex;
    flex-direction: column;
    margin-top: 1.5rem;
  }

  .video-title {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 8vw, 4.5rem);
    font-weight: 700;
    line-height: 0.92;
    text-transform: uppercase;
  }

  .listen {
    margin-top: clamp(3.5rem, 8vw, 5rem);
  }
</style>
