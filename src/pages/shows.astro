---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShowList from '../components/ShowList.astro';
import { upcomingShows } from '../data/shows';

const pastShows = [
  { date: 'June 24, 2026', venue: 'HopMonk Tavern Novato' },
  { date: 'June 6, 2026', venue: 'Private House Party' },
  { date: 'Feb 28, 2026', venue: 'Private House Party' }
];
---

<BaseLayout title="Shows — Money Back Guarantee*">
  <section class="section water page">
    <div class="wrap">
      <h1 class="section-title">Shows</h1>
      <ShowList shows={upcomingShows} origin={Astro.url.origin} />

      <h2 class="past-title">Past shows</h2>
      <ul class="shows shows--past">
        {pastShows.map((show) => (
          <li>
            <span class="show-info">
              <span class="show-date">{show.date}</span>
              <span class="show-venue">{show.venue}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* The water runs the full height of the page. */
  .page {
    min-height: calc(100svh - var(--header));
  }

  .past-title {
    margin: clamp(4rem, 9vw, 6rem) 0 0.5rem;
    font-size: clamp(2.5rem, 7vw, 4rem);
    text-align: left;
  }
</style>
