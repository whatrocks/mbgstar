---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShowTicket from '../components/ShowTicket.astro';
import { upcomingShows } from '../data/shows';

const origin = Astro.url.origin;

const pastShows = [
  { date: 'June 24, 2026', venue: 'HopMonk Tavern Novato' },
  { date: 'June 6, 2026', venue: 'Private House Party' },
  { date: 'Feb 28, 2026', venue: 'Private House Party' }
];
---

<BaseLayout title="Shows — Money Back Guarantee*">
  <div class="wrap">
    <h1 class="page-title">Shows</h1>

    <section>
      <p class="tag">Upcoming</p>
      <ul class="tickets">
        {upcomingShows.map((show) => <ShowTicket show={show} calendarOrigin={origin} />)}
      </ul>
    </section>

    <section>
      <p class="tag">Been there, rocked that</p>
      <ul class="past">
        {pastShows.map((show) => (
          <li>
            <span class="past-date">{show.date}</span>
            <span class="past-venue">{show.venue}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  section + section {
    margin-top: clamp(3.5rem, 8vw, 5rem);
  }

  .past {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .past li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 2rem;
    padding: 0.9rem 0;
    border-bottom: 2px dotted var(--line);
  }

  .past-date {
    min-width: 9rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--burnt);
  }

  .past-venue {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    font-variation-settings: "SOFT" 100, "WONK" 1;
    color: var(--muted);
  }
</style>
