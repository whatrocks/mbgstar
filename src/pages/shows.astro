---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatShowStart, googleCalendarUrl, upcomingShows } from '../data/shows';

const origin = Astro.url.origin;
---

<BaseLayout title="Shows — Money Back Guarantee*">
  <h1>Shows</h1>

  <section>
    <h2>Upcoming Shows</h2>
    <ul class="show-list">
      {upcomingShows.map((show) => (
        <li>
          <span class="show-date">{formatShowStart(show.start)}</span>
          <span class="show-name">{show.venue}</span>
          {show.detail && <span class="show-detail">{show.detail}</span>}
          <a
            class="show-calendar"
            href={googleCalendarUrl(show, origin)}
            target="_blank"
            rel="noopener noreferrer"
            title="Add to Google Calendar"
            aria-label={`Add the ${show.venue} show to Google Calendar`}
          >
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Past Shows</h2>
    <ul class="show-list">
      <li>
        <span class="show-date">June 24, 2026</span>
        <span class="show-name">HopMonk Tavern Novato</span>
      </li>
      <li>
        <span class="show-date">June 6, 2026</span>
        <span class="show-name">Private House Party</span>
      </li>
      <li>
        <span class="show-date">Feb 28, 2026</span>
        <span class="show-name">Private House Party</span>
      </li>
    </ul>
  </section>
</BaseLayout>

<style>
  section {
    margin-bottom: 2rem;
  }

  .show-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .show-list li {
    display: flex !important;
    gap: 1rem;
    align-items: baseline;
  }

  .show-date {
    font-weight: 700;
    min-width: 8rem;
  }

  .show-detail {
    opacity: 0.7;
  }

  .show-calendar {
    display: inline-flex;
    color: var(--ink);
    background: var(--paper);
    padding: 0.3rem;
    border: 2px solid var(--ink);
    box-shadow: 3px 3px 0 #000;
    transition: transform 60ms ease, box-shadow 60ms ease;
  }

  .show-calendar:hover,
  .show-calendar:focus-visible {
    transform: translate(3px, 3px);
    box-shadow: 0 0 0 #000;
  }

  .show-calendar svg {
    display: block;
  }

  @media (max-width: 640px) {
    .show-list li {
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
    }
  }
</style>
